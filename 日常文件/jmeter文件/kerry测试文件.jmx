              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="删除收货扫描的账单信息 to ${__threadGroupName}" enabled="true">
                <stringProp name="TestPlan.comments">数据库物理删除</stringProp>
                <stringProp name="dataSource">MySQLDB</stringProp>
                <stringProp name="query">#网点库存表
DELETE from tms_stat_stock where manifest_id = ${jobno_id};
#运单扫描表
DELETE from tms_manifest_pod where manifest_id = ${jobno_id};
#删除运单费用合计
DELETE from tms_manifest_fee where manifest_id = ${jobno_id};
#运单最新状态表
DELETE from tms_manifest_last_state where manifest_id = ${jobno_id};
#删除客户账单明细
DELETE from bms_invoice_detail where manifest_id = ${jobno_id};
#删除客户余额信息
DELETE from bms_cust_account where cust_id = ${cust_id};
#删除运单信息
DELETE from tms_manifest where id = ${jobno_id};
#删除货款回款账单明细
DELETE from bms_reback_invoice_detail where jobno = &apos;${jobno}&apos;;
#删除转单表信息
DELETE from tms_manifest_refno where manifest_id = ${jobno_id};</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
