        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="创建租户 to ${__threadGroupName}" enabled="false">
          <stringProp name="TestPlan.comments">数据库查询</stringProp>
          <stringProp name="dataSource">MySQLDB</stringProp>
          <stringProp name="query">/*1、新增租户*/
INSERT INTO bas_company(id, company_no, company_name, create_user_name, create_datetime)
		VALUES(${m_company_id}, ${m_company_no}, ${m_company_name}, ${m_create_user_name}, SYSDATE());
/*2、新增网点*/
INSERT INTO bas_stat(company_id, parent_id, stano, station, stat_type, standard_cur, isusing, isdel, create_user_name, create_datetime)
	      VALUES(${m_company_id}, 0, ${m_stano}, ${m_station}, &apos;1&apos;, ${m_standard_cur}, 1, 0, ${m_create_user_name}, SYSDATE());
/*3、租户菜单*/
INSERT INTO bas_company_menu(company_id, menu_id, isdel, create_user_name, create_datetime)
	SELECT ${m_company_id}, id, 0, ${m_create_user_name}, SYSDATE() FROM bas_menu WHERE module_name &lt;&gt; &apos;SYS_平台&apos;;
/*4、职位角色*/
INSERT INTO bas_role(company_id, role_name, stat_type, role_type, remark, data_type, isusing, isstandard, isdel, create_user_name, create_datetime)
	VALUES(${m_company_id}, ${m_role_name}, 1, 3, ${m_role_name}, 1, 1, 0, 0, ${m_create_user_name}, SYSDATE());
	
INSERT INTO bas_role_menu(company_id, role_id, menu_id, isdel, create_user_name, create_datetime)
	SELECT ${m_company_id},  (SELECT id FROM bas_role WHERE isdel = 0 AND company_id = ${m_company_id} AND role_name = ${m_role_name} LIMIT 1), 
		menu_id, 0, ${m_create_user_name}, SYSDATE() FROM bas_company_menu  
		WHERE company_id = ${m_company_id} AND isdel = 0;
/*5、授权*/
INSERT INTO bas_user(company_id, stat_id, user_no, user_name, PASSWORD, stat_audit_type, language_type, data_type, 
			isusing, isdel, create_user_name, create_datetime) 
	VALUES(${m_company_id}, (SELECT id FROM bas_stat WHERE isdel = 0 AND company_id = ${m_company_id} AND station = ${m_station} LIMIT 1), 
		${m_user_no}, ${m_user_name}, &apos;123456&apos;, &apos;2&apos;, &apos;CN&apos;, &apos;1&apos;, 
		1, 0, ${m_create_user_name}, SYSDATE());
		
INSERT INTO bas_user_role(company_id, user_id, role_id, isdefault, isdel, create_user_name, create_datetime)
		VALUES(${m_company_id}, (SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1),
			  (SELECT id FROM bas_role WHERE isdel = 0 AND company_id = ${m_company_id} AND role_name = ${m_role_name} LIMIT 1),
			  1, 0, ${m_create_user_name}, SYSDATE());
			  
INSERT INTO bas_user_stat(company_id, user_id, stat_id, isdefault, isdel, create_user_name, create_datetime)
		VALUES(${m_company_id}, (SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1),
			  (SELECT id FROM bas_stat WHERE isdel = 0 AND company_id = ${m_company_id} AND station = ${m_station} LIMIT 1), 
			  1, 0, ${m_create_user_name}, SYSDATE());
			  
/*6、员工*/
INSERT INTO bas_emp(user_id, company_id, sex, post_status, isusing, isdel, create_user_name, create_datetime)
		VALUES((SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1), 
			${m_company_id}, 1, 1, 1, 0, ${m_create_user_name}, SYSDATE());
</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
