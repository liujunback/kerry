#其他费用
DELETE from tms_manifest_charge where manifest_id = ${jobno_id};</stringProp>
                <stringProp name="dataSource">MySQLDB</stringProp>
                <stringProp name="query">DELETE from tms_manifest_fee where manifest_id = ${jobno_id};
DELETE from tms_manifest_pcs where manifest_id = ${jobno_id};
DELETE from tms_manifest_refno where manifest_id = ${jobno_id};
#删除客户余额信息
DELETE from bms_cust_account where cust_id = ${cust_id};
#删除子单表信息
DELETE from tms_manifest_child where no_id = ${jobno_id};
#删除运单删除备份表
DELETE from tms_manifest_delete where id = ${jobno_id};</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
