            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="新增导入模板 to ${__threadGroupName}" enabled="false">
              <stringProp name="TestPlan.comments">数据库查询</stringProp>
              <stringProp name="dataSource">MySQLDB</stringProp>
              <stringProp name="query">/*1、新增订单导入标准模板-OMS*/
/*	INSERT INTO bas_import_type(company_id, type_no, type_name, mark_field, isdel, create_user_name, create_datetime) VALUES ( ${m_company_id}, &apos;dddroms&apos;, &apos;订单列表-OMS&apos;, &apos;jobno&apos;, 0, &apos;哲盟用户&apos;, NOW());
	
	SELECT @LAST_ID2 := LAST_INSERT_ID();
*/
SELECT @LAST_ID2 := (
	SELECT
		id 
	FROM
		bas_import_type 
	WHERE
		isdel = 0 
	AND type_no = &apos;dddroms&apos; 
);
	INSERT INTO bas_import_field(company_id,type_id, field_no, field_name, is_required, isdel, create_user_name, create_datetime) 
	SELECT ${m_company_id}, @LAST_ID2 type_id, field_no, field_name, is_required, isdel, create_user_name,NOW() create_datetime FROM bas_import_field
	WHERE
	type_id = (SELECT ID FROM bas_import_type WHERE type_no = &apos;dddr&apos; AND company_id=1 ) and isdel = 0;

	INSERT INTO bas_import_tmp ( tmp_type, company_id, type_id, template_name, user_id, start_row, mark_field, isdel, create_user_name, create_datetime, modify_user_name, modify_datetime, id_old )
VALUES
	( &apos;1&apos;, ${m_company_id}, @LAST_ID2, &apos;订单导入标准模板-OMS&apos;, 0, 2, &apos;jobno&apos;, 0, &apos;哲盟用户&apos;, &apos;2019-04-28 18:29:32&apos;, NULL, &apos;2019-08-07 18:32:56&apos;, 3 );
	
	SELECT @LAST_ID := LAST_INSERT_ID();
	
	INSERT INTO bas_import_tmp_field(company_id, tmp_id, field_no, field_name, col_index, title, is_required, isdel, create_user_name, create_datetime, modify_user_name, modify_datetime)
	SELECT ${m_company_id},@LAST_ID tmp_id, field_no, field_name, col_index, title, is_required, isdel, create_user_name, create_datetime, modify_user_name, modify_datetime FROM bas_import_tmp_field
	WHERE
	tmp_id = (SELECT id FROM bas_import_tmp  where template_name = &apos;订单导入标准模板&apos; AND company_id=1 ) and isdel = 0;</stringProp>
