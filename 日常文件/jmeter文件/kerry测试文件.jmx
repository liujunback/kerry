          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="创建租户 to ${__threadGroupName}" enabled="true">
              <stringProp name="TestPlan.comments">数据库查询</stringProp>
              <stringProp name="dataSource">MySQLDB</stringProp>
              <stringProp name="query">/*1、新增租户*/
INSERT INTO bas_company(id, file_id, company_no, company_name, isdefault, create_user_name, create_datetime)
		VALUES(${m_company_id}, 3745, ${m_company_no}, ${m_company_name}, 0, ${m_create_user_name}, SYSDATE());
/*2、新增网点*/
INSERT INTO `bas_stat` (`company_id`, `parent_id`, `stano`, `station`, `statno_jian`, `stat_type`, `station_cn`, `station_en`, `country`, `state`, `city`, `standard_cur`, `liable_person`, `liable_tel`, `manager`, `manager_tel`, `complaint_tel`, `inside_tel`, `service_person`, `service_fax`, `service_tel`, `bill_user_id`, `remark`, `zip_code`, `addr1`, `addr2`, `share_type`, `bank_number`, `bank_name`, `bank_user`, `pay_agreement_file_id`, `target_code`, `target_name`, `isusing`, `isdel`, `create_user_name`, `create_datetime`, `modify_user_name`, `modify_datetime`) VALUES ( ${m_company_id}, 0, ${m_stano}, &apos;总部&apos;, ${m_stano}, &apos;1&apos;, &apos;总部&apos;, &apos;HEADQUARTERS&apos;, &apos;中国&apos;, &apos;广东&apos;, &apos;深圳&apos;, &apos;CNY&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, &apos;&apos;, NULL, &apos;&apos;, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &apos;1&apos;, &apos;0&apos;, NULL, NULL, ${m_create_user_name}, SYSDATE());

/*3、租户菜单*/
INSERT INTO bas_company_menu(company_id, menu_id, isdel, create_user_name, create_datetime)
	SELECT ${m_company_id}, id, 0, ${m_create_user_name}, SYSDATE() FROM bas_menu;
/*4、职位角色*/
INSERT INTO bas_role(company_id, role_name, stat_type, role_type, remark, data_type, isusing, isstandard, isdel, create_user_name, create_datetime)
	VALUES(${m_company_id}, ${m_role_name}, 1, 2, ${m_role_name}, 1, 1, 0, 0, ${m_create_user_name}, SYSDATE());
	
INSERT INTO bas_role_menu(company_id, role_id, menu_id, isdel, create_user_name, create_datetime)
	SELECT ${m_company_id},  (SELECT id FROM bas_role WHERE isdel = 0 AND company_id = ${m_company_id} AND role_name = ${m_role_name} LIMIT 1), 
		menu_id, 0, ${m_create_user_name}, SYSDATE() FROM bas_company_menu  
		WHERE company_id = ${m_company_id} AND isdel = 0;
/*5、授权*/
INSERT INTO bas_user(company_id, stat_id, user_no, user_name, PASSWORD, stat_audit_type, language_type, data_type, 
			isusing, isdel, create_user_name, create_datetime) 
	VALUES(${m_company_id}, (SELECT id FROM bas_stat WHERE isdel = 0 AND company_id = ${m_company_id} AND station = ${m_station} LIMIT 1), 
		${m_user_no}, ${m_user_name}, &apos;123456&apos;, &apos;2&apos;, &apos;CN&apos;, &apos;1&apos;, 
		1, 0, ${m_create_user_name}, SYSDATE());
		
INSERT INTO bas_user_role(company_id, user_id, role_id, isdefault, isdel, create_user_name, create_datetime)
		VALUES(${m_company_id}, (SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1),
			  (SELECT id FROM bas_role WHERE isdel = 0 AND company_id = ${m_company_id} AND role_name = ${m_role_name} LIMIT 1),
			  1, 0, ${m_create_user_name}, SYSDATE());
			  
INSERT INTO bas_user_stat(company_id, user_id, stat_id, isdefault, isdel, create_user_name, create_datetime)
		VALUES(${m_company_id}, (SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1),
			  (SELECT id FROM bas_stat WHERE isdel = 0 AND company_id = ${m_company_id} AND station = ${m_station} LIMIT 1), 
			  1, 0, ${m_create_user_name}, SYSDATE());
			  
/*6、员工*/
INSERT INTO bas_emp(user_id, company_id, sex, post_status, isusing, isdel, create_user_name, create_datetime)
		VALUES((SELECT id FROM bas_user WHERE isdel = 0 AND company_id = ${m_company_id} AND user_no = ${m_user_no} LIMIT 1), 
			${m_company_id}, 1, 1, 1, 0, ${m_create_user_name}, SYSDATE());

/*标准科目*/
insert into  bas_arded( `company_id`, `arded_code`, `arded_name`, `arded_type`, `work_type`, `remark`, `isstandard`, `isusing`, `isdel`, `create_user_name`, `create_datetime`)
select  ${m_company_id}, `arded_code`, `arded_name`, `arded_type`, `work_type`, `remark`, `isstandard`, `isusing`, `isdel`, `create_user_name`, SYSDATE() from bas_arded where isstandard=1 and company_id=${p_standard_id} and isdel=0;

/*扫描状态*/
INSERT INTO bas_scan_status(`company_id`, `scan_code`, `scan_name`, `scan_type`, `goods_status`, `remark_cn`, `remark_en`, `sort`, `isstandard`, `isusing`, `isabnormal`, `isclose`, `isshow`, `isdel`, `create_user_name`, `create_datetime`, `modify_user_name`, `modify_datetime`) 
		SELECT ${m_company_id}, `scan_code`, `scan_name`, `scan_type`, `goods_status`, `remark_cn`, `remark_en`, `sort`, `isstandard`, `isusing`, `isabnormal`, `isclose`, `isshow`, `isdel`, `create_user_name`, SYSDATE(), `modify_user_name`, `modify_datetime` from bas_scan_status WHERE company_id =100000;

</stringProp>
