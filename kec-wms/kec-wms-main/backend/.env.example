# ============================================
# 数据库配置 (MySQL)
# ============================================
DATABASE_URL="mysql://用户名:密码@MySQL服务器IP:3306/kec_wms"
DB_HOST=MySQL服务器IP
DB_PORT=3306

# ============================================
# Redis 配置
# ============================================
REDIS_URL="redis://Redis服务器IP:6379/0"
REDIS_HOST=Redis服务器IP
REDIS_PORT=6379

# ============================================
# NextAuth 配置
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# ============================================
# JWT 配置
# ============================================
JWT_SECRET="your-jwt-secret-change-in-production"

# ============================================
# 应用配置
# ============================================
NODE_ENV=development
# PDA 下载二维码对外访问地址。
# 例如：http://192.168.1.100:3000 或 https://wms.example.com
# 未配置时会优先使用请求头中的真实 Host，若仍为 0.0.0.0/localhost，则自动回退到服务器局域网 IP。
PDA_PUBLIC_BASE_URL="http://192.168.1.100:3000"

# ============================================
# 迁移控制
# ============================================
RUN_MIGRATIONS=true
RUN_SEED=false

# ============================================
# API 文档配置 (Swagger UI)
# ============================================
# 用于 Swagger UI 的默认测试 API Key（仅用于开发/测试环境）
NEXT_PUBLIC_DEFAULT_API_KEY="wms_eefdcbfa0f02443dc1970b6eb5144246b983075cb58a58880fb93397f75cacaf"

# ============================================
# 日志配置
# ============================================
# 默认 channel: console | file | gelf | stack
LOG_CHANNEL=stack
# 最低记录级别: DEBUG | INFO | NOTICE | WARNING | ERROR | CRITICAL | ALERT | EMERGENCY
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_DAYS=15
# error 级别独立文件
LOG_ERROR_FILE_PATH=/app/logs/error.log

# ============================================
# 队列配置
# ============================================
# 默认任务最大重试次数
QUEUE_JOB_ATTEMPTS=3
# 默认任务重试退避基础间隔（毫秒，指数退避）
QUEUE_JOB_BACKOFF_DELAY_MS=1000
# 后台任务编号创建锁 TTL（毫秒）
QUEUE_JOB_CREATE_LOCK_TTL_MS=60000
# 后台任务编号创建锁重试次数
QUEUE_JOB_CREATE_LOCK_RETRY_COUNT=1200
# 后台任务编号创建锁重试间隔（毫秒）
QUEUE_JOB_CREATE_LOCK_RETRY_DELAY_MS=100
# 已完成任务保留时长（秒）
QUEUE_JOB_REMOVE_ON_COMPLETE_AGE_SEC=86400
# 已完成任务最多保留数量
QUEUE_JOB_REMOVE_ON_COMPLETE_COUNT=1000
# 失败任务保留时长（秒）
QUEUE_JOB_REMOVE_ON_FAIL_AGE_SEC=604800

# 自动库存分配队列并发数
QUEUE_INVENTORY_ALLOCATION_CONCURRENCY=10
# 自动库存分配队列限流窗口内最大任务数
QUEUE_INVENTORY_ALLOCATION_LIMITER_MAX=500
# 自动库存分配队列限流窗口时长（毫秒）
QUEUE_INVENTORY_ALLOCATION_LIMITER_DURATION_MS=60000
# 自动库存分配事务获取连接最大等待时间（毫秒）
QUEUE_INVENTORY_ALLOCATION_TX_MAX_WAIT_MS=10000
# 自动库存分配事务超时时间（毫秒）
QUEUE_INVENTORY_ALLOCATION_TX_TIMEOUT_MS=30000

# 库存快照队列并发数
QUEUE_INVENTORY_SNAPSHOT_CONCURRENCY=1
# 库存快照队列限流窗口内最大任务数
QUEUE_INVENTORY_SNAPSHOT_LIMITER_MAX=5
# 库存快照队列限流窗口时长（毫秒）
QUEUE_INVENTORY_SNAPSHOT_LIMITER_DURATION_MS=60000

# 报表导出队列并发数
QUEUE_REPORT_EXPORT_CONCURRENCY=3
# 报表导出队列限流窗口内最大任务数
QUEUE_REPORT_EXPORT_LIMITER_MAX=10
# 报表导出队列限流窗口时长（毫秒）
QUEUE_REPORT_EXPORT_LIMITER_DURATION_MS=60000

# 数据导入队列并发数
QUEUE_DATA_UPLOAD_CONCURRENCY=2
# 数据导入队列限流窗口内最大任务数
QUEUE_DATA_UPLOAD_LIMITER_MAX=5
# 数据导入队列限流窗口时长（毫秒）
QUEUE_DATA_UPLOAD_LIMITER_DURATION_MS=60000

# 发运状态推送队列并发数
QUEUE_SHIPMENT_STATUS_PUSH_CONCURRENCY=10
# 发运状态推送队列限流窗口内最大任务数
QUEUE_SHIPMENT_STATUS_PUSH_LIMITER_MAX=200
# 发运状态推送队列限流窗口时长（毫秒）
QUEUE_SHIPMENT_STATUS_PUSH_LIMITER_DURATION_MS=60000

# 任务文件存储目录
JOB_FILES_PATH=./storage/jobs
# 任务文件保留时长（毫秒）
JOB_FILES_MAX_AGE_MS=604800000
# 外部 API 监控日志独立文件
LOG_EXTERNAL_API_FILE_PATH=/app/logs/external-api.log
# stack channel 包含的子 channel（逗号分隔）
LOG_STACK_CHANNELS=file,file-error,gelf

# Graylog GELF 配置
GRAYLOG_HOST=10.247.65.115
GRAYLOG_PORT=12201
# 传输协议: udp | tcp
GRAYLOG_TRANSPORT=udp
GRAYLOG_FACILITY=kec-wms

# ============================================
# 打包视频 S3 下载配置（私有桶）
# ============================================
AWS_KEY=
AWS_SECRET=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
# 可选：自建对象存储（如 MinIO）时配置
# AWS_ENDPOINT=
# AWS_FORCE_PATH_STYLE=false

