/// 客户仓库关联表 - 客户与仓库的多对多关系
model ClientWarehouse {
  /// 主键ID
  id            String    @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId      String    @map("tenant_id") @db.Char(36)
  /// 客户ID
  clientId      String    @map("client_id") @db.Char(36)
  /// 仓库ID
  warehouseId   String    @map("warehouse_id") @db.Char(36)
  /// 是否默认仓库
  isDefault     Boolean   @default(false) @map("is_default")
  /// 是否启用
  isActive      Boolean   @default(true) @map("is_active")
  /// 生效日期
  effectiveDate DateTime? @map("effective_date") @db.Date
  /// 失效日期
  expiryDate    DateTime? @map("expiry_date") @db.Date
  /// 配置信息（JSON格式）
  config        Json
  /// 创建时间
  createdAt     DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy     String?   @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy     String?   @map("updated_by") @db.Char(36)
  client        Client    @relation(fields: [clientId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([clientId, warehouseId])
  @@index([tenantId])
  @@index([clientId])
  @@index([warehouseId])
  @@index([isActive])
  @@map("client_warehouse")
}

/// 库存事件表 - 记录所有库存变动（事件溯源）
model InventoryEvent {
  /// 主键ID
  id              String      @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String      @map("tenant_id") @db.Char(36)
  /// 客户ID（可选）
  clientId        String?     @map("client_id") @db.Char(36)
  /// 仓库ID
  warehouseId     String      @map("warehouse_id") @db.Char(36)
  /// 库位ID
  locationId      String      @map("location_id") @db.Char(36)
  /// SKU ID
  skuId           String      @map("sku_id") @db.Char(36)
  /// SKU编码
  skuCode         String      @map("sku_code") @db.VarChar(64)
  /// 批次号（空字符串表示无批次）
  batchNumber     String      @default("") @map("batch_number") @db.VarChar(64)
  /// LPN容器编号（空字符串表示无LPN）
  lpn             String      @default("") @db.VarChar(64)
  /// ASN单号（追溯来源）
  asnNumber       String      @default("") @map("asn_number") @db.VarChar(64)
  /// 事件编号
  eventNumber     String      @unique @map("event_number") @db.VarChar(32)
  /// 事件类型：PUTAWAY/ALLOCATE/DEALLOCATE/PICK/UNPICK/SHIP/FREEZE/UNFREEZE等
  eventType       String      @map("event_type") @db.VarChar(32)
  /// 事件子类型
  eventSubType    String?     @map("event_sub_type") @db.VarChar(32)
  /// 桶类型：AVAILABLE/ALLOCATED/FROZEN/DEFECTIVE/PICKING/QC_HOLD
  bucketType      String      @map("bucket_type") @db.VarChar(32)
  /// 数量变化（正增负减）
  quantityDelta   Int         @map("quantity_delta")
  /// 变动前数量
  quantityBefore  Int         @map("quantity_before")
  /// 变动后数量
  quantityAfter   Int         @map("quantity_after")
  /// 关联单据类型
  referenceType   String?     @map("reference_type") @db.VarChar(32)
  /// 关联单据ID
  referenceId     String?     @map("reference_id") @db.Char(36)
  /// 关联单据编号
  referenceNumber String?     @map("reference_number") @db.VarChar(64)
  /// 关联单据行ID
  referenceLineId String?     @map("reference_line_id") @db.Char(36)
  /// 幂等键（防重复）
  idempotencyKey  String      @unique @map("idempotency_key") @db.VarChar(128)
  /// 父事件ID
  parentEventId   String?     @map("parent_event_id") @db.Char(36)
  /// 原因代码
  reasonCode      String?     @map("reason_code") @db.VarChar(32)
  /// 原因说明
  reasonDesc      String?     @map("reason_desc") @db.VarChar(255)
  /// 单位成本
  unitCost        Decimal?    @map("unit_cost") @db.Decimal(18, 4)
  /// 总成本
  totalCost       Decimal?    @map("total_cost") @db.Decimal(18, 4)
  /// 操作人ID
  operatorId      String?     @map("operator_id") @db.Char(36)
  /// 事件日期
  eventDate       DateTime    @map("event_date")
  /// 创建时间
  createdAt       DateTime    @default(now()) @map("created_at")
  client          Client?     @relation(fields: [clientId], references: [id])
  location        BinLocation @relation(fields: [locationId], references: [id])
  sku             Sku         @relation(fields: [skuId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, warehouseId, skuId, locationId])
  @@index([eventType, eventDate])
  @@index([referenceType, referenceId])
  @@index([asnNumber])
  @@index([clientId], map: "inventory_event_client_id_fkey")
  @@index([locationId], map: "inventory_event_location_id_fkey")
  @@index([skuId], map: "inventory_event_sku_id_fkey")
  @@index([warehouseId], map: "inventory_event_warehouse_id_fkey")
  @@map("inventory_event")
}

/// 库存桶表 - 按业务类型分离的库存数量
model InventoryBucket {
  /// 主键ID
  id             String             @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId       String             @map("tenant_id") @db.Char(36)
  /// 客户ID
  clientId       String             @map("client_id") @db.Char(36)
  /// 仓库ID
  warehouseId    String             @map("warehouse_id") @db.Char(36)
  /// 库区ID
  zoneId         String             @map("zone_id") @db.Char(36)
  /// 库位ID
  locationId     String             @map("location_id") @db.Char(36)
  /// SKU ID
  skuId          String             @map("sku_id") @db.Char(36)
  /// SKU编码
  skuCode        String             @map("sku_code") @db.VarChar(64)
  /// 批次号（空字符串表示无批次）
  batchNumber    String             @default("") @map("batch_number") @db.VarChar(64)
  /// LPN容器编号（空字符串表示无LPN）
  lpn            String             @default("") @db.VarChar(64)
  /// ASN单号（追溯来源批次）
  asnNumber      String             @default("") @map("asn_number") @db.VarChar(64)
  /// 桶类型：AVAILABLE/ALLOCATED/FROZEN/DEFECTIVE/EXCEPTION/PICKING/QC_HOLD/COUNT_HOLD/COUNT_SURPLUS/COUNT_SHORTAGE
  bucketType     String             @map("bucket_type") @db.VarChar(32)
  /// 数量
  quantity       Int                @default(0)
  /// 版本号（乐观锁）
  version        BigInt             @default(0)
  /// 到期日期
  expiryDate     DateTime?          @map("expiry_date") @db.Date
  /// 生产日期
  productionDate DateTime?          @map("production_date") @db.Date
  /// FIFO日期（先进先出排序）
  fifoDate       DateTime?          @map("fifo_date")
  /// 最后事件ID
  lastEventId    String?            @map("last_event_id") @db.Char(36)
  /// 创建时间
  createdAt      DateTime           @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime           @updatedAt @map("updated_at")
  allocations    AllocationDetail[]
  client         Client             @relation(fields: [clientId], references: [id])
  location       BinLocation        @relation(fields: [locationId], references: [id])
