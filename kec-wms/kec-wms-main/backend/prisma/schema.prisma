/// ASN主表 - 预到货通知单主表
model Asn {
  /// 主键ID
  id                     String                 @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String                 @map("tenant_id") @db.Char(36)
  /// 客户ID
  clientId               String                 @map("client_id") @db.Char(36)
  /// 仓库ID
  warehouseId            String                 @map("warehouse_id") @db.Char(36)
  /// ASN单号
  asnNumber              String                 @map("asn_number") @db.VarChar(32)
  /// 外部单号
  externalNumber         String?                @map("external_number") @db.VarChar(64)
  /// ASN类型：NORMAL-普通入库, RETURN-退货入库, TRANSFER-调拨入库
  asnType                String                 @default("NORMAL") @map("asn_type") @db.VarChar(32)
  receiving_method       String?                @db.VarChar(255)
  /// 状态：CREATED-已创建, ARRIVED-已到货, RECEIVING-收货中, PUTAWAY-上架中, COMPLETED-已完成, CANCELLED-已取消
  status                 String                 @default("CREATED") @db.VarChar(32)
  /// 预计到货日期
  expectedArrivalDate    DateTime?              @map("expected_arrival_date") @db.Date
  /// 预计到货时间
  expectedArrivalTime    String?                @map("expected_arrival_time") @db.VarChar(8)
  /// 预计上架完成时间
  expectedPutawayDate    DateTime?              @map("expected_putaway_date")
  /// 实际到货时间
  actualArrivalAt        DateTime?              @map("actual_arrival_at")
  /// 签收时间
  signedAt               DateTime?              @map("signed_at")
  /// 签收人ID
  signedBy               String?                @map("signed_by") @db.Char(36)
  /// 收货开始时间
  receivingStartAt       DateTime?              @map("receiving_start_at")
  /// 收货结束时间
  receivingEndAt         DateTime?              @map("receiving_end_at")
  /// 上架开始时间
  putawayStartAt         DateTime?              @map("putaway_start_at")
  /// 上架结束时间
  putawayEndAt           DateTime?              @map("putaway_end_at")
  /// 完成时间
  completedAt            DateTime?              @map("completed_at")
  /// 预期总数量
  totalExpectedQty       Int                    @default(0) @map("total_expected_qty")
  /// 已收货总数量
  totalReceivedQty       Int                    @default(0) @map("total_received_qty")
  /// 已上架总数量
  totalPutawayQty        Int                    @default(0) @map("total_putaway_qty")
  /// 预期总行数
  totalExpectedLines     Int                    @default(0) @map("total_expected_lines")
  /// 已收货行数
  totalReceivedLines     Int                    @default(0) @map("total_received_lines")
  /// 预期总体积（立方米）
  totalExpectedVolumeCbm Decimal?               @map("total_expected_volume_cbm") @db.Decimal(12, 4)
  /// 预期总重量（千克）
  totalExpectedWeightKg  Decimal?               @map("total_expected_weight_kg") @db.Decimal(12, 3)
  /// 收货月台ID
  receivingDockId        String?                @map("receiving_dock_id") @db.Char(36)
  /// 备注
  notes                  String?                @db.Text
  /// 配置信息（JSON格式）
  config                 Json
  /// 创建时间
  createdAt              DateTime               @default(now()) @map("created_at")
  /// 更新时间
  updatedAt              DateTime               @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy              String?                @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy              String?                @map("updated_by") @db.Char(36)
  client                 Client                 @relation(fields: [clientId], references: [id])
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  warehouse              Warehouse              @relation(fields: [warehouseId], references: [id])
  asnLines               AsnLine[]
  containerItems         ContainerItem[]
  putawayOrders          PutawayOrder[]
  putawayOrderLines      PutawayOrderLine[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  receivingRecords       ReceivingRecord[]

  @@unique([tenantId, asnNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([warehouseId])
  @@index([status])
  @@index([asnType])
  @@index([expectedArrivalDate])
  @@index([expectedPutawayDate])
  @@index([externalNumber])
  @@map("asn")
}

/// ASN明细表 - 预到货通知单明细
