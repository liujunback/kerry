  asnLines               AsnLine[]
  comboComponents        ComboComponent[]
  containerItems         ContainerItem[]
  inventoryAlerts        InventoryAlert[]
  inventoryBuckets       InventoryBucket[]
  inventoryEvents        InventoryEvent[]
  inventorySnapshots     InventorySnapshot[]
  inventoryTransferLines InventoryTransferLine[]
  outboundOrderLines     OutboundOrderLine[]
  pickOrderLines         PickOrderLine[]
  putawayDetails         PutawayDetail[]
  putawayOrderLines      PutawayOrderLine[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  receivingRecords       ReceivingRecord[]
  returnOrderLines       ReturnOrderLine[]
  returnPutawayDetails   ReturnPutawayDetail[]
  returnPutawayLines     ReturnPutawayLine[]
  serialNumbers          SerialNumber[]
  category               SkuCategory?            @relation(fields: [categoryId], references: [id])
  client                 Client                  @relation(fields: [clientId], references: [id])
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  attributes             SkuAttribute[]
  barcodes               SkuBarcode[]
  images                 SkuImage[]
  skuInventorySummaries  SkuInventorySummary[]
  uoms                   SkuUom[]
  sortingTaskLines       SortingTaskLine[]

  @@unique([clientId, skuCode])
  @@index([tenantId])
  @@index([clientId])
  @@index([categoryId])
  @@index([barcode])
  @@index([status])
  @@index([abcClass])
  @@index([skuName])
  @@index([isFirstReceiving])
