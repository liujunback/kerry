/// 后台任务表 - 异步任务队列记录
model BackgroundJob {
  /// 主键ID
  id              String    @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String    @map("tenant_id") @db.Char(36)
  /// 任务编号
  jobNumber       String    @map("job_number") @db.VarChar(32)
  /// BullMQ任务ID
  bullJobId       String?   @map("bull_job_id") @db.VarChar(64)
  /// 任务类型：INVENTORY_ALLOCATION, REPORT_EXPORT, DATA_UPLOAD, SHIPMENT_STATUS_PUSH
  jobType         String    @map("job_type") @db.VarChar(32)
  /// 任务子类型：ASN, ORDER, SKU（用于DATA_UPLOAD）
  jobSubType      String?   @map("job_sub_type") @db.VarChar(32)
  /// 任务名称
  jobName         String    @map("job_name") @db.VarChar(128)
  /// 任务描述
  description     String?   @db.VarChar(512)
  /// 状态：PENDING-待处理, PROCESSING-处理中, COMPLETED-已完成, FAILED-失败, CANCELLED-已取消
  status          String    @default("PENDING") @db.VarChar(32)
  /// 优先级：1-最高, 10-最低
  priority        Int       @default(5)
  /// 输入参数（JSON格式）
  inputData       Json      @map("input_data")
  /// 处理结果（JSON格式）
  resultData      Json?     @map("result_data")
  /// 错误信息
  errorMessage    String?   @map("error_message") @db.Text
  /// 错误堆栈
  errorStack      String?   @map("error_stack") @db.Text
  /// 进度百分比（0-100）
  progress        Int       @default(0)
  /// 进度消息
  progressMessage String?   @map("progress_message") @db.VarChar(512)
  /// 已处理数量
  processedCount  Int       @default(0) @map("processed_count")
  /// 总数量
  totalCount      Int       @default(0) @map("total_count")
  /// 成功数量
  successCount    Int       @default(0) @map("success_count")
  /// 失败数量
  failedCount     Int       @default(0) @map("failed_count")
  /// 结果文件路径
  resultFilePath  String?   @map("result_file_path") @db.VarChar(512)
  /// 结果文件名
  resultFileName  String?   @map("result_file_name") @db.VarChar(256)
  /// 结果文件大小（字节）
  resultFileSize  Int?      @map("result_file_size")
  /// 结果文件过期时间
  resultExpiresAt DateTime? @map("result_expires_at")
  /// 重试次数
  retryCount      Int       @default(0) @map("retry_count")
  /// 最大重试次数
  maxRetries      Int       @default(3) @map("max_retries")
  /// 计划执行时间
  scheduledAt     DateTime? @map("scheduled_at")
  /// 开始执行时间
  startedAt       DateTime? @map("started_at")
  /// 完成时间
  completedAt     DateTime? @map("completed_at")
  /// 仓库ID（可选，用于仓库级任务）
  warehouseId     String?   @map("warehouse_id") @db.Char(36)
  /// 客户ID（可选，用于客户级任务）
  clientId        String?   @map("client_id") @db.Char(36)
  /// 创建时间
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy       String?   @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy       String?   @map("updated_by") @db.Char(36)
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@index([createdBy])
  @@index([warehouseId])
  @@index([clientId])
  @@map("background_job")
}

/// API密钥表 - 外部系统集成认证密钥
model ApiKey {
