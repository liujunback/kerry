  cellCode      String                  @map("cell_code") @db.VarChar(64)
  /// 格口位置编码 (如 A1, B2) - 在同一播种墙内的相对位置
  cellPosition  String                  @map("cell_position") @db.VarChar(16)
  /// 行号 (从1开始)
  rowNumber     Int                     @map("row_number")
  /// 列号 (从1开始)
  columnNumber  Int                     @map("column_number")
  /// 是否启用
  isActive      Boolean                 @default(true) @map("is_active")
  /// 当前状态：EMPTY-空闲, ALLOCATED-已分配, SORTING-分拣中, COMPLETED-已完成
  status        String                  @default("EMPTY") @db.VarChar(32)
  /// 备注
  remarks       String?                 @db.VarChar(256)
  /// 创建时间
  createdAt     DateTime                @default(now()) @map("created_at")
  /// 更新时间
  updatedAt     DateTime                @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy     String?                 @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy     String?                 @map("updated_by") @db.Char(36)
  allocations   SortingCellAllocation[]
  sortingWall   SortingWall             @relation(fields: [sortingWallId], references: [id])
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse               @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, warehouseId, cellCode])
  @@unique([sortingWallId, cellPosition])
  @@index([tenantId, warehouseId])
  @@index([sortingWallId])
  @@index([cellCode])
  @@index([status])
  @@map("sorting_cell")
}

/// 分拣任务主表 - 二次分拣任务
