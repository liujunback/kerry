/// 库区表 - 仓库内的区域划分
model Zone {
  /// 主键ID
  id                 String              @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId           String              @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId        String              @map("warehouse_id") @db.Char(36)
  /// 库区编码
  zoneCode           String              @map("zone_code") @db.VarChar(32)
  /// 库区名称
  zoneName           String?             @map("zone_name") @db.VarChar(128)
  /// 库区类型：STORAGE-存储区, PICKING-拣货区, STAGING-暂存区, RECEIVING-收货区, SHIPPING-发货区
  zoneType           String              @map("zone_type") @db.VarChar(32)
  /// 质量类型：GOOD-良品, DEFECTIVE-次品, DAMAGED-损坏
  qualityType        String              @default("GOOD") @map("quality_type") @db.VarChar(20)
  /// 容量上限（单位数）
  capacityUnits      Int?                @map("capacity_units")
  /// 当前使用量
  currentUnits       Int                 @default(0) @map("current_units")
  /// 状态：ACTIVE-启用, INACTIVE-停用
  status             String              @default("ACTIVE") @db.VarChar(20)
  /// 创建时间
  createdAt          DateTime            @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime            @updatedAt @map("updated_at")
  binLocations       BinLocation[]
  inventoryBuckets   InventoryBucket[]
  inventorySnapshots InventorySnapshot[]
  pickerProfileZones PickerProfileZone[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, zoneCode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([zoneType])
  @@map("zone")
}

/// 库位表 - 仓库内的具体存储位置
model BinLocation {
  /// 主键ID
  id                   String                  @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId             String                  @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId          String                  @map("warehouse_id") @db.Char(36)
  /// 库区ID
  zoneId               String                  @map("zone_id") @db.Char(36)
  /// 库位编码
  locationCode         String                  @map("location_code") @db.VarChar(32)
  /// 巷道号
  aisle                String?                 @db.VarChar(8)
  /// 货架号
  rack                 String?                 @db.VarChar(8)
  /// 层号
  shelf                String?                 @db.VarChar(8)
  /// 格号
  bin                  String?                 @db.VarChar(8)
  /// 库位类型：STORAGE-存储位, PICKING-拣货位, STAGING-暂存位
  locationType         String?                 @map("location_type") @db.VarChar(32)
  /// 锁定状态：UNLOCKED-未锁定, LOCKED-已锁定
  lockStatus           String                  @default("UNLOCKED") @map("lock_status") @db.VarChar(20)
  /// 是否可拣货
  isPickable           Boolean                 @default(false) @map("is_pickable")
  /// 是否可收货
  isReceivable         Boolean                 @default(false) @map("is_receivable")
  /// 长度（厘米）
  lengthCm             Decimal?                @map("length_cm") @db.Decimal(10, 2)
  /// 宽度（厘米）
  widthCm              Decimal?                @map("width_cm") @db.Decimal(10, 2)
  /// 高度（厘米）
  heightCm             Decimal?                @map("height_cm") @db.Decimal(10, 2)
  /// 上架优先级（数值越小优先级越高）
  putawayPriority      Int                     @default(100) @map("putaway_priority")
  /// 拣货优先级（数值越小优先级越高）
  pickPriority         Int                     @default(100) @map("pick_priority")
  /// 拣货顺序（用于规划拣货路径）
  pickSequence         Int                     @default(0) @map("pick_sequence")
  /// 最大SKU数（该库位可存放的最大SKU种类数）
  maxSkuCount          Int                     @default(1) @map("max_sku_count")
  /// 状态：ACTIVE-启用, INACTIVE-停用
  status               String                  @default("ACTIVE") @db.VarChar(20)
  /// 最后盘点时间
  lastCountedAt        DateTime?               @map("last_counted_at")
  /// 创建时间
  createdAt            DateTime                @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime                @updatedAt @map("updated_at")
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  warehouse            Warehouse               @relation(fields: [warehouseId], references: [id])
  zone                 Zone                    @relation(fields: [zoneId], references: [id])
  inventoryBuckets     InventoryBucket[]
  inventoryEvents      InventoryEvent[]
  inventorySnapshots   InventorySnapshot[]
  transferSourceLines  InventoryTransferLine[] @relation("TransferSourceLocation")
  transferTargetLines  InventoryTransferLine[] @relation("TransferTargetLocation")
  pickOrderLines       PickOrderLine[]         @relation("PickOrderLineLocation")
  putawayDetails       PutawayDetail[]
  returnOrderLines     ReturnOrderLine[]       @relation("ReturnTempLocation")
  returnPutawayDetails ReturnPutawayDetail[]
  returnPutawayLines   ReturnPutawayLine[]     @relation("ReturnPutawayTargetLocation")

  @@unique([warehouseId, locationCode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([locationType])
  @@index([status])
  @@map("bin_location")
}

/// 容器表 - 入库/出库使用的容器信息
model Container {
  /// 主键ID
  id                     String                 @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String                 @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId            String                 @map("warehouse_id") @db.Char(36)
  /// 容器编码
  containerCode          String                 @map("container_code") @db.VarChar(32)
  /// 容器类型：PALLET-托盘, CARTON-纸箱, TOTE-周转箱
  containerType          String                 @map("container_type") @db.VarChar(32)
  /// 用途：INBOUND-入库, OUTBOUND-出库
  usage                  String                 @db.VarChar(20)
  /// 启用状态：ENABLED-启用, DISABLED-停用
  enabledStatus          String                 @default("ENABLED") @map("enabled_status") @db.VarChar(20)
  /// 工作状态：IDLE-空闲, OCCUPIED-占用中
  workStatus             String                 @default("IDLE") @map("work_status") @db.VarChar(20)
  /// 最后占用时间
  lastOccupiedTime       DateTime?              @map("last_occupied_time")
  /// 承重上限（千克）
  weightCapacityKg       Decimal?               @map("weight_capacity_kg") @db.Decimal(10, 2)
  /// 长度（厘米）
  lengthCm               Decimal?               @map("length_cm") @db.Decimal(10, 2)
  /// 宽度（厘米）
  widthCm                Decimal?               @map("width_cm") @db.Decimal(10, 2)
  /// 高度（厘米）
  heightCm               Decimal?               @map("height_cm") @db.Decimal(10, 2)
  /// 备注
  remarks                String?                @db.Text
  /// 创建时间
  createdAt              DateTime               @default(now()) @map("created_at")
  /// 更新时间
  updatedAt              DateTime               @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy              String?                @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy              String?                @map("updated_by") @db.Char(36)
  /// 当前关联的ASN ID（收货时使用）
  currentAsnId           String?                @map("current_asn_id") @db.Char(36)
  /// 当前批次号（收货时使用）
  currentBatchNumber     String?                @map("current_batch_number") @db.VarChar(64)
  /// 当前质量状态（收货时使用）：GOOD-良品, DAMAGED-破损
  currentQualityStatus   String?                @map("current_quality_status") @db.VarChar(32)
  /// 当前关联的SKU ID（收货时使用）
  currentSkuId           String?                @map("current_sku_id") @db.Char(36)
  /// 容器来源类型：INTERNAL_MANAGED-内部管理容器, INTERNAL_TEMP-内部临时容器, EXTERNAL_ASN-外部ASN原箱
  sourceType             String                 @default("INTERNAL_MANAGED") @map("source_type") @db.VarChar(32)
  /// 关箱时间
  closedAt               DateTime?              @map("closed_at")
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  warehouse              Warehouse              @relation(fields: [warehouseId], references: [id])
  containerItems         ContainerItem[]
  putawayDetails         PutawayDetail[]
  putawayOrderLines      PutawayOrderLine[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  receivingRecords       ReceivingRecord[]
  returnOrderLines       ReturnOrderLine[]
  returnPutawayDetails   ReturnPutawayDetail[]
  returnPutawayLines     ReturnPutawayLine[]

  @@unique([tenantId, containerCode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([containerType])
  @@index([usage])
  @@index([enabledStatus])
  @@index([workStatus])
  @@map("container")
}

