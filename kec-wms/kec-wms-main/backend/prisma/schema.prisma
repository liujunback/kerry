  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([tenantId, markedAt])
  @@index([orderId])
  @@index([orderId, isActive])
  @@map("order_interception_case")
}

/// 波次表 - 出库波次管理
model Wave {
  /// 主键ID
  id                String          @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId          String          @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId       String          @map("warehouse_id") @db.Char(36)
  /// 波次号
  waveNumber        String          @map("wave_number") @db.VarChar(32)
  /// 波次类型：STANDARD-标准波次, EXPRESS-加急波次
  waveType          String          @default("STANDARD") @map("wave_type") @db.VarChar(32)
  /// 来源类型：MANUAL-手工建波次, STRATEGY-策略建波次
  sourceType        String          @default("MANUAL") @map("source_type") @db.VarChar(32)
  /// 来源策略ID
  strategyId        String?         @map("strategy_id") @db.Char(36)
  /// 来源策略版本ID
  strategyVersionId String?         @map("strategy_version_id") @db.Char(36)
  /// 来源策略执行ID
  strategyRunId     String?         @map("strategy_run_id") @db.Char(36)
  /// 波次类型编码
  waveTypeCode      String?         @map("wave_type_code") @db.VarChar(64)
  /// 拣货模式
  pickMode          String?         @map("pick_mode") @db.VarChar(32)
  /// 后续路径：PACK_DIRECT-直接打包, SORT_THEN_PACK-系统分拣后打包
  downstreamMode    String?         @map("downstream_mode") @db.VarChar(32)
  /// 释放模式：IMMEDIATE-立即释放, MANUAL-手动释放
  releaseMode       String?         @default("MANUAL") @map("release_mode") @db.VarChar(32)
  /// 释放状态：PENDING_RELEASE-待释放, RELEASED-已释放
  releaseStatus     String?         @default("PENDING_RELEASE") @map("release_status") @db.VarChar(32)
  /// 策略执行批次号
  batchNo           Int?            @map("batch_no")
  /// 状态：CREATED-已创建, RELEASED-已释放, PICKING-拣货中, COMPLETED-已完成, CANCELLED-已取消
  status            String          @default("CREATED") @db.VarChar(32)
  /// 优先级（1-10，数字越小优先级越高）
  priority          Int             @default(5)
  /// 订单总数
  totalOrders       Int             @default(0) @map("total_orders")
  /// 订单ID列表（JSON格式）
  orderIds          Json?           @map("order_ids")
  /// 总行数
  totalLines        Int             @default(0) @map("total_lines")
  /// 总数量
  totalQty          Int             @default(0) @map("total_qty")
  /// SKU种类数
  totalSkuCount     Int             @default(0) @map("total_sku_count")
  /// 已拣货订单数
  pickedOrders      Int             @default(0) @map("picked_orders")
  /// 已拣货数量
  pickedQty         Int             @default(0) @map("picked_qty")
  /// 计划开始时间
  plannedStartAt    DateTime?       @map("planned_start_at")
  /// 实际开始时间
  actualStartAt     DateTime?       @map("actual_start_at")
  /// 实际结束时间
  actualEndAt       DateTime?       @map("actual_end_at")
  /// 拣货策略：ORDER-按单拣货, SKU-按SKU拣货, ZONE-按库区拣货
  pickStrategy      String          @default("ORDER") @map("pick_strategy") @db.VarChar(32)
  /// 库区ID列表（JSON格式）
  zoneIds           Json?           @map("zone_ids")
  /// 备注
  notes             String?         @db.Text
  /// 执行快照（JSON格式）
  configSnapshot    Json?           @map("config_snapshot")
  /// 创建时间
  createdAt         DateTime        @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime        @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy         String?         @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy         String?         @map("updated_by") @db.Char(36)
  orders            OutboundOrder[]
  pickOrders        PickOrder[]
  waveOrders        WaveOrder[]
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, waveNumber])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
  @@index([waveType])
  @@index([sourceType])
  @@index([strategyId])
  @@index([strategyVersionId])
  @@index([strategyRunId])
  @@index([waveTypeCode])
  @@index([releaseStatus])
  @@map("wave")
}

/// 波次订单关系表 - 记录波次与订单的绑定关系
model WaveOrder {
  /// 主键ID
  id                 String        @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId           String        @map("tenant_id") @db.Char(36)
  /// 波次ID
  waveId             String        @map("wave_id") @db.Char(36)
  /// 订单ID
  orderId            String        @map("order_id") @db.Char(36)
  /// 订单号
  orderNumber        String        @map("order_number") @db.VarChar(64)
  /// 波次类型编码
  waveTypeCode       String?       @map("wave_type_code") @db.VarChar(64)
  /// 拣货模式
  pickMode           String?       @map("pick_mode") @db.VarChar(32)
  /// 后续路径
  downstreamMode     String?       @map("downstream_mode") @db.VarChar(32)
  /// 来源策略运行订单明细ID
  strategyRunOrderId String?       @map("strategy_run_order_id") @db.Char(36)
  /// 创建时间
  createdAt          DateTime      @default(now()) @map("created_at")
  order              OutboundOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wave               Wave          @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@unique([waveId, orderId])
  @@index([tenantId])
  @@index([orderId])
  @@index([waveTypeCode])
  @@map("wave_order")
}

/// 波次策略主表 - 保存策略基础信息
model WaveStrategy {
  /// 主键ID
  id               String                @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId         String                @map("tenant_id") @db.Char(36)
  /// 适用仓库ID
  warehouseId      String                @map("warehouse_id") @db.Char(36)
  /// 策略编码
  strategyCode     String                @map("strategy_code") @db.VarChar(64)
  /// 策略名称
  strategyName     String                @map("strategy_name") @db.VarChar(128)
  /// 策略描述
  description      String?               @db.Text
  /// 优先级，数值越小优先级越高
  priority         Int                   @default(100)
  /// 状态：DRAFT-草稿, ENABLED-已启用, DISABLED-已禁用, ARCHIVED-已归档
  status           String                @default("DRAFT") @db.VarChar(32)
  /// 当前版本ID
  currentVersionId String?               @map("current_version_id") @db.Char(36)
  /// 最新版本号
  latestVersionNo  Int                   @default(1) @map("latest_version_no")
  /// 是否逻辑删除
  isDeleted        Boolean               @default(false) @map("is_deleted")
  /// 创建时间
  createdAt        DateTime              @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime              @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy        String?               @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy        String?               @map("updated_by") @db.Char(36)
  currentVersion   WaveStrategyVersion?  @relation("WaveStrategyCurrentVersion", fields: [currentVersionId], references: [id])
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])
  versions         WaveStrategyVersion[] @relation("WaveStrategyVersions")
  runs             WaveStrategyRun[]

  @@unique([tenantId, strategyCode])
  @@index([tenantId, warehouseId, status, priority])
  @@index([warehouseId])
  @@index([currentVersionId])
  @@map("wave_strategy")
}

/// 波次策略版本表 - 保存策略发布快照
model WaveStrategyVersion {
  /// 主键ID
  id                  String               @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId            String               @map("tenant_id") @db.Char(36)
  /// 策略ID
  strategyId          String               @map("strategy_id") @db.Char(36)
  /// 版本号
  versionNo           Int                  @map("version_no")
  /// 版本状态：EDITING-编辑中, PUBLISHED-已发布, ROLLED_BACK-已回滚, ABANDONED-已废弃
  versionStatus       String               @default("EDITING") @map("version_status") @db.VarChar(32)
  /// 是否当前生效版本
  isCurrent           Boolean              @default(false) @map("is_current")
  /// 变更说明
  changeSummary       String?              @map("change_summary") @db.VarChar(512)
  /// 完整配置快照
  configSnapshot      Json                 @map("config_snapshot")
  /// 发布时间
  publishedAt         DateTime?            @map("published_at")
  /// 发布人ID
  publishedBy         String?              @map("published_by") @db.Char(36)
  /// 创建时间
  createdAt           DateTime             @default(now()) @map("created_at")
  /// 创建人ID
  createdBy           String?              @map("created_by") @db.Char(36)
  currentOfStrategies WaveStrategy[]       @relation("WaveStrategyCurrentVersion")
  strategy            WaveStrategy         @relation("WaveStrategyVersions", fields: [strategyId], references: [id], onDelete: Cascade)
  ruleSet             WaveStrategyRuleSet?
  runs                WaveStrategyRun[]

  @@unique([strategyId, versionNo])
  @@index([tenantId])
  @@index([strategyId, isCurrent])
  @@map("wave_strategy_version")
}

/// 波次策略规则集表 - 保存结构化配置
model WaveStrategyRuleSet {
  /// 主键ID
  id                  String              @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId            String              @map("tenant_id") @db.Char(36)
  /// 策略版本ID
  strategyVersionId   String              @unique @map("strategy_version_id") @db.Char(36)
  /// 触发配置
  triggerConfigJson   Json                @map("trigger_config_json")
  /// 筛选配置
  filterConfigJson    Json                @map("filter_config_json")
  /// 执行控制配置
  executionConfigJson Json                @map("execution_config_json")
  /// 波次类型配置
  waveTypeConfigJson  Json                @map("wave_type_config_json")
  /// 拣货规则配置
  pickConfigJson      Json                @map("pick_config_json")
  /// 释放规则配置
  releaseConfigJson   Json                @map("release_config_json")
  /// 创建时间
  createdAt           DateTime            @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime            @updatedAt @map("updated_at")
  strategyVersion     WaveStrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("wave_strategy_rule_set")
}

/// 波次策略运行主表 - 记录每一次模拟或执行
model WaveStrategyRun {
  /// 主键ID
  id                     String                 @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String                 @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId            String                 @map("warehouse_id") @db.Char(36)
  /// 策略ID
  strategyId             String                 @map("strategy_id") @db.Char(36)
  /// 策略版本ID
  strategyVersionId      String                 @map("strategy_version_id") @db.Char(36)
  /// 运行模式：SIMULATE-模拟, EXECUTE-执行
  runMode                String                 @default("SIMULATE") @map("run_mode") @db.VarChar(16)
  /// 触发类型：MANUAL-手动, SCHEDULED-定时, API-接口
  triggerType            String                 @map("trigger_type") @db.VarChar(32)
  /// 执行状态：RUNNING-执行中, SUCCESS-成功, PARTIAL_SUCCESS-部分成功, FAILED-失败
  runStatus              String                 @default("RUNNING") @map("run_status") @db.VarChar(32)
  /// 候选订单数
  candidateOrderCount    Int                    @default(0) @map("candidate_order_count")
  /// 命中订单数
  matchedOrderCount      Int                    @default(0) @map("matched_order_count")
  /// 被更高优先级抢占订单数
  claimedByHigherCount   Int                    @default(0) @map("claimed_by_higher_count")
  /// 未归类订单数
  unclassifiedOrderCount Int                    @default(0) @map("unclassified_order_count")
  /// 生成波次数
  createdWaveCount       Int                    @default(0) @map("created_wave_count")
  /// 生成拣货单数
  createdPickOrderCount  Int                    @default(0) @map("created_pick_order_count")
  /// 错误信息
  errorMessage           String?                @map("error_message") @db.Text
  /// 开始时间
  startedAt              DateTime               @default(now()) @map("started_at")
  /// 结束时间
  finishedAt             DateTime?              @map("finished_at")
  /// 触发人ID
  triggeredBy            String?                @map("triggered_by") @db.Char(36)
  /// 请求参数
  requestPayload         Json?                  @map("request_payload")
  /// 创建时间
  createdAt              DateTime               @default(now()) @map("created_at")
  orders                 WaveStrategyRunOrder[]
  strategy               WaveStrategy           @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyVersion        WaveStrategyVersion    @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, warehouseId, createdAt])
  @@index([strategyId, startedAt])
  @@index([strategyVersionId])
  @@index([runStatus])
  @@map("wave_strategy_run")
}

/// 波次策略运行订单明细表 - 记录订单处理结果
model WaveStrategyRunOrder {
  /// 主键ID
  id                  String          @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId            String          @map("tenant_id") @db.Char(36)
  /// 运行ID
  runId               String          @map("run_id") @db.Char(36)
  /// 订单ID
  orderId             String          @map("order_id") @db.Char(36)
  /// 批次号
  batchNo             Int             @default(1) @map("batch_no")
  /// 是否命中当前策略
  matchedStrategy     Boolean         @default(false) @map("matched_strategy")
  /// 抢占当前订单的策略ID
  claimedByStrategyId String?         @map("claimed_by_strategy_id") @db.Char(36)
  /// 波次类型编码
  waveTypeCode        String?         @map("wave_type_code") @db.VarChar(64)
  /// 拣货模式
  pickMode            String?         @map("pick_mode") @db.VarChar(32)
  /// 后续路径
  downstreamMode      String?         @map("downstream_mode") @db.VarChar(32)
  /// 处理结果：MATCHED-命中, SKIPPED-跳过, UNCLASSIFIED-未归类, WAVED-已组波, FAILED-失败
  resultStatus        String          @map("result_status") @db.VarChar(32)
  /// 生成的波次ID
  waveId              String?         @map("wave_id") @db.Char(36)
  /// 生成的拣货单ID
  pickOrderId         String?         @map("pick_order_id") @db.Char(36)
  /// 结果说明
  message             String?         @db.VarChar(512)
  /// 命中规则快照
  matchedRuleSnapshot Json?           @map("matched_rule_snapshot")
  /// 创建时间
  createdAt           DateTime        @default(now()) @map("created_at")
  order               OutboundOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  run                 WaveStrategyRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, orderId])
  @@index([tenantId])
  @@index([orderId])
  @@index([waveId])
  @@index([pickOrderId])
  @@index([resultStatus])
  @@map("wave_strategy_run_order")
}

/// 拣货单表 - 拣货单主表
model PickOrder {
  /// 主键ID
  id                     String          @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String          @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId            String          @map("warehouse_id") @db.Char(36)
  /// 任务编号
  taskNumber             String          @map("task_number") @db.VarChar(32)
  /// 波次ID
  waveId                 String?         @map("wave_id") @db.Char(36)
  /// 来源策略运行ID
  strategyRunId          String?         @map("strategy_run_id") @db.Char(36)
  /// 波次类型编码
  waveTypeCode           String?         @map("wave_type_code") @db.VarChar(64)
  /// 拣货单类型：SINGLE_SKU_SINGLE-单品单件(同款), MULTI_SKU_SINGLE-单品单件(不同款), SINGLE_SKU_MULTI-单品多件, MULTI_SKU_MULTI-多品多件
  taskType               String          @default("SINGLE_SKU_SINGLE") @map("task_type") @db.VarChar(32)
  order_business_type    String          @default("STANDARD") @db.VarChar(32)
  /// 状态：PENDING-待执行, IN_PROGRESS-执行中, PICKED-已拣货, SORTING-分拣中, PACKING-打包中, COMPLETED-已完成, CANCELLED-已取消
  status                 String          @default("PENDING") @db.VarChar(32)
  /// 优先级（1-10，数字越小优先级越高）
  priority               Int             @default(5)
  /// 分配人ID
  assignedUserId         String?         @map("assigned_user_id") @db.Char(36)
  /// 分配时间
  assignedAt             DateTime?       @map("assigned_at")
  /// 分配来源：MANUAL-人工指定, AUTO_RULE-规则自动分配
  assignmentSource       String?         @map("assignment_source") @db.VarChar(32)
  /// 分配策略类型：ROUND_ROBIN/LEAST_ACTIVE_TASKS/ZONE_FIRST
  assignmentStrategyType String?         @map("assignment_strategy_type") @db.VarChar(32)
  /// 开始时间
  startedAt              DateTime?       @map("started_at")
  /// 完成时间
  completedAt            DateTime?       @map("completed_at")
  /// 总行数
  totalLines             Int             @default(0) @map("total_lines")
  /// 总数量
  totalQty               Int             @default(0) @map("total_qty")
  /// 已拣货数量
  pickedQty              Int             @default(0) @map("picked_qty")
  /// 拣货顺序
  pickSequence           Int?            @map("pick_sequence")
  /// 目标容器编号
  targetContainer        String?         @map("target_container") @db.VarChar(64)
  /// 设备ID
  deviceId               String?         @map("device_id") @db.VarChar(64)
  /// 拣货方式：PAPER-纸质单, PDA-PDA, RF-RF枪
  pickMethod             String?         @map("pick_method") @db.VarChar(32)
  /// 备注
  notes                  String?         @db.Text
  /// 拣货模式：AGGREGATE-汇总拣货, PICK_THEN_SORT-先拣后分, PICK_AND_SORT-边拣边分
  pickMode               String?         @map("pick_mode") @db.VarChar(32)
  /// 后续路径：PACK_DIRECT-直接打包, SORT_THEN_PACK-系统分拣后打包
  downstreamMode         String?         @map("downstream_mode") @db.VarChar(32)
  /// 创建时间
  createdAt              DateTime        @default(now()) @map("created_at")
  /// 更新时间
  updatedAt              DateTime        @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy              String?         @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy              String?         @map("updated_by") @db.Char(36)
  tenant                 Tenant          @relation(fields: [tenantId], references: [id])
  warehouse              Warehouse       @relation(fields: [warehouseId], references: [id])
  wave                   Wave?           @relation(fields: [waveId], references: [id])
  lines                  PickOrderLine[]
  sortingTasks           SortingTask[]

  @@unique([tenantId, taskNumber])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([waveId])
  @@index([strategyRunId])
  @@index([waveTypeCode])
  @@index([downstreamMode])
  @@index([status])
  @@index([assignedUserId])
  @@index([assignmentSource])
  @@index([assignmentStrategyType])
  @@index([pickSequence])
  @@map("pick_order")
}

/// 拣货单明细表 - 拣货单明细
model PickOrderLine {
  /// 主键ID
  id          String            @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId    String            @map("tenant_id") @db.Char(36)
  /// 拣货单ID
  pickOrderId String            @map("pick_order_id") @db.Char(36)
  /// 行号
  lineNumber  Int               @map("line_number")
  /// 订单ID
  orderId     String            @map("order_id") @db.Char(36)
  /// 订单行ID
  orderLineId String            @map("order_line_id") @db.Char(36)
  /// SKU ID
  skuId       String            @map("sku_id") @db.Char(36)
  /// SKU编码
  skuCode     String            @map("sku_code") @db.VarChar(64)
  /// 库位ID
  locationId  String            @map("location_id") @db.Char(36)
  /// 库存桶ID（新设计：引用InventoryBucket）
  bucketId    String            @map("bucket_id") @db.Char(36)
  /// 批次号
  batchNumber String?           @map("batch_number") @db.VarChar(64)
  /// LPN容器编号
  lpn         String?           @db.VarChar(64)
  /// 预期数量
  expectedQty Int               @default(0) @map("expected_qty")
  /// 已拣货数量
  pickedQty   Int               @default(0) @map("picked_qty")
  /// 已打包数量
  packedQty   Int               @default(0) @map("packed_qty")
  /// 已发货数量
  shippedQty  Int               @default(0) @map("shipped_qty")
  /// 缺货数量
  shortQty    Int               @default(0) @map("short_qty")
  /// 状态：PENDING-待拣货, PICKED-已拣货, SHORT-缺货
  status      String            @default("PENDING") @db.VarChar(32)
  /// 拣货时间
  pickedAt    DateTime?         @map("picked_at")
  /// 拣货人ID
  pickedBy    String?           @map("picked_by") @db.Char(36)
  /// 备注
  notes       String?           @db.Text
  /// 创建时间
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime          @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy   String?           @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy   String?           @map("updated_by") @db.Char(36)
  bucket      InventoryBucket   @relation(fields: [bucketId], references: [id])
  location    BinLocation       @relation("PickOrderLineLocation", fields: [locationId], references: [id])
  order       OutboundOrder     @relation(fields: [orderId], references: [id])
  orderLine   OutboundOrderLine @relation(fields: [orderLineId], references: [id])
  task        PickOrder         @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)
  sku         Sku               @relation(fields: [skuId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id])

  @@unique([pickOrderId, lineNumber])
