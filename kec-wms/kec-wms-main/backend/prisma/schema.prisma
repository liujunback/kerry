  /// 平台原始订单ID
  platformOrderId        String?                   @map("platform_order_id") @db.VarChar(64)
  /// 订单来源：MANUAL-手工创建, API-API导入, IMPORT-批量导入, PLATFORM-平台同步
  orderSource            String                    @default("MANUAL") @map("order_source") @db.VarChar(32)
  /// 出库业务类型：STANDARD=标准出库, RETURN_WAREHOUSE=退仓出库, SCRAP=下架销毁, OTHER=其他出库
  orderBusinessType      String                    @default("STANDARD") @map("order_business_type") @db.VarChar(32)
  /// 订单结构类型：SINGLE_ITEM_SINGLE=单品单件, SINGLE_ITEM_MULTI=单品多件, MULTI_ITEM=多品订单
  orderType              String                    @default("SINGLE_ITEM_SINGLE") @map("order_type") @db.VarChar(32)
  /// 状态：CREATED/PENDING/ALLOCATED/PENDING_WAVE/IN_WAVE/WAVED/PICKING/PICKED/SORTING/SORTED/PACKING/PACKED/READY_SHIP/SHIPPED/DELIVERED/CANCELLED/ON_HOLD/EXCEPTION
  status                 String                    @default("CREATED") @db.VarChar(32)
  outbound_address_id    String?                   @db.Char(36)
  /// 配送方式
  shippingMethod         String?                   @map("shipping_method") @db.VarChar(64)
  /// 运单号
  trackingNumber         String?                   @map("tracking_number") @db.VarChar(64)
  /// 订购总数量
  totalOrderedQty        Int                       @default(0) @map("total_ordered_qty")
  /// 已分配总数量
  totalAllocatedQty      Int                       @default(0) @map("total_allocated_qty")
  /// 已拣货总数量
  totalPickedQty         Int                       @default(0) @map("total_picked_qty")
  /// 已打包总数量
  totalPackedQty         Int                       @default(0) @map("total_packed_qty")
  /// 已发货总数量
  totalShippedQty        Int                       @default(0) @map("total_shipped_qty")
  /// SKU种类数
  totalSkuCount          Int                       @default(0) @map("total_sku_count")
  /// 总重量（千克）
  totalWeightKg          Decimal?                  @map("total_weight_kg") @db.Decimal(12, 3)
  /// 总体积（立方米）
  totalVolumeCbm         Decimal?                  @map("total_volume_cbm") @db.Decimal(12, 4)
  /// 波次ID
  waveId                 String?                   @map("wave_id") @db.Char(36)
  /// 命中的波次策略ID
  waveStrategyId         String?                   @map("wave_strategy_id") @db.Char(36)
  /// 命中的波次策略版本ID
  waveStrategyVersionId  String?                   @map("wave_strategy_version_id") @db.Char(36)
  /// 波次类型编码
  waveTypeCode           String?                   @map("wave_type_code") @db.VarChar(64)
  /// 后续路径：PACK_DIRECT-直接打包, SORT_THEN_PACK-系统分拣后打包
  downstreamMode         String?                   @map("downstream_mode") @db.VarChar(32)
  /// 是否需要合单
  needConsolidation      Boolean                   @default(false) @map("need_consolidation")
  /// 是否已合单
  isCombined             Boolean                   @default(false) @map("is_combined")
  /// 合单后的订单ID
  combinedOrderId        String?                   @map("combined_order_id") @db.Char(36)
  /// 换号状态：SUCCESS=换号成功, FAILED=换号失败, NONE=不换号
  numberChangeStatus     String                    @default("NONE") @map("number_change_status") @db.VarChar(16)
  /// 是否含序列号商品
  hasSerialItems         Boolean                   @default(false) @map("has_serial_items")
  /// 发货总单ID
  manifestOrderId        String?                   @map("manifest_order_id") @db.Char(36)
  /// 备注
  notes                  String?                   @db.Text
  /// 配置信息（JSON格式）
  config                 Json
  /// 创建时间
  createdAt              DateTime                  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy              String?                   @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy              String?                   @map("updated_by") @db.Char(36)
  checkoutRecords        CheckoutRecord[]
  outbound_order_address OrderAddress?             @relation(fields: [outbound_address_id], references: [id], map: "outbound_order_address_id_fkey")
  client                 Client                    @relation(fields: [clientId], references: [id])
  manifestOrder          ManifestOrder?            @relation(fields: [manifestOrderId], references: [id])
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id])
  warehouse              Warehouse                 @relation(fields: [warehouseId], references: [id])
  wave                   Wave?                     @relation(fields: [waveId], references: [id])
  extension              OutboundOrderExtension?
  waveContext            OutboundOrderWaveContext?
  lines                  OutboundOrderLine[]
  timeline               OrderTimeline?
  interceptionCases      OrderInterceptionCase[]
  pickOrderLines         PickOrderLine[]
  shipments              Shipment[]
  sortingCellAllocations SortingCellAllocation[]
  sortingTaskLines       SortingTaskLine[]
  returnOrders           ReturnOrder[]
  waveOrders             WaveOrder[]
  waveStrategyRunOrders  WaveStrategyRunOrder[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, clientId, referenceNumber], map: "uq_outbound_order_tenant_client_reference")
  @@index([tenantId])
  @@index([clientId])
  @@index([warehouseId])
  @@index([status])
  @@index([tenantId, warehouseId, waveId, status, createdAt])
  @@index([orderBusinessType])
  @@index([orderType])
  @@index([platform])
  @@index([waveId])
  @@index([waveStrategyId])
  @@index([waveStrategyVersionId])
  @@index([waveTypeCode])
  @@index([downstreamMode])
  @@index([referenceNumber])
  @@index([numberChangeStatus])
  @@index([outbound_address_id], map: "outbound_order_address_id_fkey")
  @@index([manifestOrderId], map: "outbound_order_manifest_order_id_fkey")
  @@map("outbound_order")
}

/// 出库订单明细表 - 出库订单明细
