generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 租户表 - 多租户系统的租户信息
model Tenant {
  /// 主键ID
  id                            String                         @id @default(uuid()) @db.Char(36)
  /// 租户编码（唯一标识）
  tenantCode                    String                         @unique @map("tenant_code") @db.VarChar(32)
  /// 租户名称
  tenantName                    String                         @map("tenant_name") @db.VarChar(128)
  /// 联系人姓名
  contactPerson                 String?                        @map("contact_person") @db.VarChar(64)
  /// 联系电话
  contactPhone                  String?                        @map("contact_phone") @db.VarChar(32)
  /// 联系邮箱
  contactEmail                  String?                        @map("contact_email") @db.VarChar(128)
  /// 地址
  address                       String?                        @db.Text
  /// 状态：ACTIVE-启用, INACTIVE-停用
  status                        String                         @default("ACTIVE") @db.VarChar(20)
  /// 租户配置（JSON格式）
  config                        Json
  /// 创建时间
  createdAt                     DateTime                       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy                     String?                        @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy                     String?                        @map("updated_by") @db.Char(36)
  allocationDetails             AllocationDetail[]
  apiKeys                       ApiKey[]
  asns                          Asn[]
  asnLines                      AsnLine[]
  audits                        Audit[]
  backgroundJobs                BackgroundJob[]
  binLocations                  BinLocation[]
  checkoutOrders                CheckoutOrder[]
  checkoutRecords               CheckoutRecord[]
  clients                       Client[]
  clientWarehouses              ClientWarehouse[]
  comboComponents               ComboComponent[]
  comboProducts                 ComboProduct[]
  containers                    Container[]
  containerItems                ContainerItem[]
  inventoryAdjustments          InventoryAdjustment[]
  inventoryAlerts               InventoryAlert[]
  inventoryBuckets              InventoryBucket[]
  inventoryEvents               InventoryEvent[]
  inventorySnapshots            InventorySnapshot[]
  inventoryTransfers            InventoryTransfer[]
  inventoryTransferLines        InventoryTransferLine[]
  loginHistories                LoginHistory[]
  manifestOrders                ManifestOrder[]
  operationLogs                 OperationLog[]
  outboundOrders                OutboundOrder[]
  asnSequences                  AsnSequence[]
  outboundOrderSequences        OutboundOrderSequence[]
  pickOrderSequences            PickOrderSequence[]
  orderAddresses                OrderAddress[]
  outboundOrderExtensions       OutboundOrderExtension[]
  outboundOrderLines            OutboundOrderLine[]
  orderTimelines                OrderTimeline[]
  packagingMaterials            PackagingMaterial[]
  packagingMaterialInventories  PackagingMaterialInventory[]
  packagingMaterialTransactions PackagingMaterialTransaction[]
  packagingMaterialUsages       PackagingMaterialUsage[]
  pickAssignmentRules           PickAssignmentRule[]
  pickerProfiles                PickerProfile[]
  pickerProfileZones            PickerProfileZone[]
  pickOrders                    PickOrder[]
  pickOrderLines                PickOrderLine[]
  printDevices                  PrintDevice[]
  printHistories                PrintHistory[]
  printTemplates                PrintTemplate[]
  putawayDetails                PutawayDetail[]
  putawayOrders                 PutawayOrder[]
  putawayOrderLines             PutawayOrderLine[]
  receivingDiscrepancies        ReceivingDiscrepancy[]
  receivingRecords              ReceivingRecord[]
  returnLineDispositions        ReturnLineDisposition[]
  returnOrderLines              ReturnOrderLine[]
  returnOrders                  ReturnOrder[]
  returnPutawayDetails          ReturnPutawayDetail[]
  returnPutawayLines            ReturnPutawayLine[]
  returnPutawayOrders           ReturnPutawayOrder[]
  roles                         Role[]
  rolePermissions               RolePermission[]
  scheduledTasks                ScheduledTask[]
  scheduledTaskLogs             ScheduledTaskLog[]
  serialNumbers                 SerialNumber[]
  shipments                     Shipment[]
  shortReceiveReasonCodes       ShortReceiveReasonCode[]
  skus                          Sku[]
  skuAttributes                 SkuAttribute[]
  skuBarcodes                   SkuBarcode[]
  skuCategories                 SkuCategory[]
  skuImages                     SkuImage[]
  skuInventorySummaries         SkuInventorySummary[]
  skuUoms                       SkuUom[]
  sortingCellAllocations        SortingCellAllocation[]
  sortingCells                  SortingCell[]
  sortingTasks                  SortingTask[]
  sortingTaskLines              SortingTaskLine[]
  sortingWalls                  SortingWall[]
  users                         User[]
  userWarehouses                UserWarehouse[]
  userRoles                     UserRole[]
  warehouses                    Warehouse[]
  waves                         Wave[]
  waveStrategies                WaveStrategy[]
  zones                         Zone[]
  orderInterceptionCases        OrderInterceptionCase[]

  @@map("tenant")
}

/// 用户表 - 系统用户账户信息
model User {
  /// 主键ID
  id                     String            @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String            @map("tenant_id") @db.Char(36)
  /// 用户名（登录账号）
  username               String            @db.VarChar(64)
  /// 密码哈希值
  passwordHash           String            @map("password_hash") @db.VarChar(255)
  /// 邮箱地址
  email                  String?           @db.VarChar(128)
  /// 手机号码
  phone                  String?           @db.VarChar(32)
  /// 用户全名
  fullName               String            @map("full_name") @db.VarChar(128)
  /// 员工工号
  employeeId             String?           @map("employee_id") @db.VarChar(64)
  /// 所属部门
  department             String?           @db.VarChar(128)
  /// 职位
  position               String?           @db.VarChar(64)
  /// 头像URL
  avatarUrl              String?           @map("avatar_url") @db.VarChar(512)
  /// 用户类型：INTERNAL-内部用户, EXTERNAL-外部用户
  userType               String            @default("INTERNAL") @map("user_type") @db.VarChar(32)
  /// 状态：ACTIVE-启用, INACTIVE-停用, LOCKED-锁定
  status                 String            @default("ACTIVE") @db.VarChar(32)
  /// 是否激活
  isActive               Boolean           @default(true) @map("is_active")
  /// 最后登录时间
  lastLoginAt            DateTime?         @map("last_login_at")
  /// 最后登录IP
  lastLoginIp            String?           @map("last_login_ip") @db.VarChar(45)
  /// PDA 登录二维码失效时间
  pdaLoginQrExpiresAt    DateTime?         @map("pda_login_qr_expires_at")
  /// 密码修改时间
  passwordChangedAt      DateTime?         @map("password_changed_at")
  /// 密码过期时间
  passwordExpiresAt      DateTime?         @map("password_expires_at")
  /// 登录失败次数
  failedLoginCount       Int               @default(0) @map("failed_login_count")
  /// 锁定时间
  lockedAt               DateTime?         @map("locked_at")
  /// 锁定截止时间
  lockedUntil            DateTime?         @map("locked_until")
  /// 用户配置（JSON格式）
  config                 Json
  /// 创建时间
  createdAt              DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt              DateTime          @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy              String?           @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy              String?           @map("updated_by") @db.Char(36)
  inventoryAlerts        InventoryAlert[]
  loginHistories         LoginHistory[]
  passwordHistories      PasswordHistory[]
  printHistories         PrintHistory[]
  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  pickerProfiles         PickerProfile[]
  userWarehouses         UserWarehouse[]
  userRoles              UserRole[]
  checkoutRecordsScanned CheckoutRecord[]  @relation("CheckoutRecordScannedBy")

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([pdaLoginQrExpiresAt])
  @@index([employeeId])
  @@map("user")
}

/// 角色表 - 系统角色定义
model Role {
  /// 主键ID
  id              String           @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String           @map("tenant_id") @db.Char(36)
  /// 角色编码（唯一标识）
  roleCode        String           @map("role_code") @db.VarChar(32)
  /// 角色名称
  roleName        String           @map("role_name") @db.VarChar(64)
  /// 角色描述
  description     String?          @db.Text
  /// 角色级别（1-最高级，数字越大级别越低）
  roleLevel       Int              @default(3) @map("role_level")
  /// 父角色ID（用于角色继承）
  parentRoleId    String?          @map("parent_role_id") @db.Char(36)
  /// 是否系统内置角色
  isSystem        Boolean          @default(false) @map("is_system")
  /// 是否启用
  isActive        Boolean          @default(true) @map("is_active")
  /// 排序序号
  sortOrder       Int              @default(0) @map("sort_order")
  /// 创建时间
  createdAt       DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime         @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy       String?          @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy       String?          @map("updated_by") @db.Char(36)
  parentRole      Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles      Role[]           @relation("RoleHierarchy")
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, roleCode])
  @@index([tenantId])
  @@index([roleLevel])
  @@index([parentRoleId])
  @@index([isActive])
  @@map("role")
}

/// 权限表 - 系统权限定义
model Permission {
  /// 主键ID
  id              String           @id @default(uuid()) @db.Char(36)
  /// 权限编码（唯一标识）
  permissionCode  String           @unique @map("permission_code") @db.VarChar(128)
  /// 权限名称
  permissionName  String           @map("permission_name") @db.VarChar(128)
  /// 权限描述
  description     String?          @db.Text
  /// 资源类型：MENU-菜单, BUTTON-按钮, API-接口
  resourceType    String           @map("resource_type") @db.VarChar(32)
  /// 操作类型：CREATE-创建, READ-读取, UPDATE-更新, DELETE-删除
  action          String           @db.VarChar(32)
  /// 权限分类
  category        String           @db.VarChar(64)
  /// 父权限ID（用于权限层级）
  parentId        String?          @map("parent_id") @db.Char(36)
  /// 是否系统内置权限
  isSystem        Boolean          @default(true) @map("is_system")
  /// 是否启用
  isActive        Boolean          @default(true) @map("is_active")
  /// 排序序号
  sortOrder       Int              @default(0) @map("sort_order")
  /// 创建时间
  createdAt       DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime         @updatedAt @map("updated_at")
  parent          Permission?      @relation("PermissionHierarchy", fields: [parentId], references: [id])
  children        Permission[]     @relation("PermissionHierarchy")
  rolePermissions RolePermission[]

  @@index([resourceType])
  @@index([action])
  @@index([category])
  @@index([parentId])
  @@index([isActive])
  @@map("permission")
}

/// 用户角色关联表 - 用户与角色的多对多关系
model UserRole {
  /// 主键ID
  id            String    @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId      String    @map("tenant_id") @db.Char(36)
  /// 用户ID
  userId        String    @map("user_id") @db.Char(36)
  /// 角色ID
  roleId        String    @map("role_id") @db.Char(36)
  /// 作用域类型：GLOBAL-全局, WAREHOUSE-仓库级, ZONE-库区级
  scopeType     String    @default("GLOBAL") @map("scope_type") @db.VarChar(32)
  /// 作用域ID（对应仓库或库区ID）
  scopeId       String?   @map("scope_id") @db.Char(36)
  /// 是否主要角色
  isPrimary     Boolean   @default(false) @map("is_primary")
  /// 分配人ID
  assignedBy    String    @map("assigned_by") @db.Char(36)
  /// 分配时间
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  /// 生效日期
  effectiveDate DateTime? @map("effective_date") @db.Date
  /// 过期时间
  expiresAt     DateTime? @map("expires_at")
  /// 是否启用
  isActive      Boolean   @default(true) @map("is_active")
  /// 创建时间
  createdAt     DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt     DateTime  @updatedAt @map("updated_at")
  role          Role      @relation(fields: [roleId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@index([isActive])
  @@map("user_role")
}

/// 用户仓库关联表 - 用户与可操作仓库的多对多关系
model UserWarehouse {
  /// 主键ID
  id          String    @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId    String    @map("tenant_id") @db.Char(36)
  /// 用户ID
  userId      String    @map("user_id") @db.Char(36)
  /// 仓库ID
  warehouseId String    @map("warehouse_id") @db.Char(36)
  /// 是否默认仓库
  isDefault   Boolean   @default(false) @map("is_default")
  /// 是否启用
  isActive    Boolean   @default(true) @map("is_active")
  /// 创建时间
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy   String?   @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy   String?   @map("updated_by") @db.Char(36)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([userId, warehouseId])
  @@index([tenantId])
  @@index([userId])
  @@index([warehouseId])
  @@index([isDefault])
  @@index([isActive])
  @@map("user_warehouse")
}

/// 拣货分配规则表 - 仓库级自动分配配置
model PickAssignmentRule {
  /// 主键ID
  id                          String         @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId                    String         @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId                 String         @map("warehouse_id") @db.Char(36)
  /// 规则编码
  ruleCode                    String         @map("rule_code") @db.VarChar(64)
  /// 规则名称
  ruleName                    String         @map("rule_name") @db.VarChar(128)
  /// 规则描述
  description                 String?        @db.Text
  /// 状态：DRAFT-草稿, ENABLED-启用, DISABLED-禁用
  status                      String         @default("DRAFT") @db.VarChar(32)
  /// 是否默认规则
  isDefault                   Boolean        @default(false) @map("is_default")
  /// 规则配置JSON
  configJson                  Json           @map("config_json")
  /// 上次分配到的拣货员档案ID
  lastAssignedPickerProfileId String?        @map("last_assigned_picker_profile_id") @db.Char(36)
  /// 上次分配时间
  lastAssignedAt              DateTime?      @map("last_assigned_at")
  /// 创建时间
  createdAt                   DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy                   String?        @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy                   String?        @map("updated_by") @db.Char(36)
  tenant                      Tenant         @relation(fields: [tenantId], references: [id])
  warehouse                   Warehouse      @relation(fields: [warehouseId], references: [id])
  lastAssignedPickerProfile   PickerProfile? @relation("PickAssignmentRuleLastAssignedPicker", fields: [lastAssignedPickerProfileId], references: [id])

  @@unique([tenantId, ruleCode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([lastAssignedPickerProfileId])
  @@index([tenantId, warehouseId, status])
  @@index([tenantId, warehouseId, isDefault])
  @@map("pick_assignment_rule")
}

/// 拣货员档案表 - 仓库级派工候选人配置
model PickerProfile {
  /// 主键ID
  id                   String               @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId             String               @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId          String               @map("warehouse_id") @db.Char(36)
  /// 用户ID
  userId               String               @map("user_id") @db.Char(36)
  /// 最大活跃任务数
  maxActiveTasks       Int                  @default(3) @map("max_active_tasks")
  /// 轮询顺序号
  sequenceNo           Int                  @default(1) @map("sequence_no")
  /// 是否启用
  isEnabled            Boolean              @default(true) @map("is_enabled")
  /// 是否允许 PDA 执行
  allowPdaExecution    Boolean              @default(true) @map("allow_pda_execution")
  /// 创建时间
  createdAt            DateTime             @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime             @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy            String?              @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy            String?              @map("updated_by") @db.Char(36)
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  warehouse            Warehouse            @relation(fields: [warehouseId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
  zones                PickerProfileZone[]
  lastAssignedForRules PickAssignmentRule[] @relation("PickAssignmentRuleLastAssignedPicker")

  @@unique([tenantId, warehouseId, userId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([userId])
  @@index([tenantId, warehouseId, isEnabled])
  @@index([tenantId, warehouseId, sequenceNo])
  @@map("picker_profile")
}

/// 拣货员负责区域表 - 拣货员与库区的多对多关系
model PickerProfileZone {
  /// 主键ID
  id              String        @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String        @map("tenant_id") @db.Char(36)
  /// 拣货员档案ID
  pickerProfileId String        @map("picker_profile_id") @db.Char(36)
  /// 库区ID
  zoneId          String        @map("zone_id") @db.Char(36)
  /// 创建时间
  createdAt       DateTime      @default(now()) @map("created_at")
  pickerProfile   PickerProfile @relation(fields: [pickerProfileId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  zone            Zone          @relation(fields: [zoneId], references: [id])

  @@unique([pickerProfileId, zoneId])
  @@index([tenantId])
  @@index([pickerProfileId])
  @@index([zoneId])
  @@map("picker_profile_zone")
}

/// 角色权限关联表 - 角色与权限的多对多关系
model RolePermission {
  /// 主键ID
  id           String     @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId     String     @map("tenant_id") @db.Char(36)
  /// 角色ID
  roleId       String     @map("role_id") @db.Char(36)
  /// 权限ID
  permissionId String     @map("permission_id") @db.Char(36)
  /// 权限限制条件（JSON格式）
  limitation   Json?
  /// 是否授予权限
  isGranted    Boolean    @default(true) @map("is_granted")
  /// 创建时间
  createdAt    DateTime   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime   @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy    String?    @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy    String?    @map("updated_by") @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

/// 登录历史表 - 用户登录记录
model LoginHistory {
  /// 主键ID
  id            String    @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId      String    @map("tenant_id") @db.Char(36)
  /// 用户ID
  userId        String    @map("user_id") @db.Char(36)
  /// 用户名
  username      String    @db.VarChar(64)
  /// 登录类型：PASSWORD-密码登录, SSO-单点登录, TOKEN-令牌登录
  loginType     String    @default("PASSWORD") @map("login_type") @db.VarChar(32)
  /// 登录结果：SUCCESS-成功, FAILED-失败
  loginResult   String    @map("login_result") @db.VarChar(32)
  /// 失败原因
  failureReason String?   @map("failure_reason") @db.VarChar(128)
  /// 登录IP地址
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  /// 用户代理（浏览器信息）
  userAgent     String?   @map("user_agent") @db.Text
  /// 设备类型：PC-电脑, MOBILE-手机, TABLET-平板
  deviceType    String?   @map("device_type") @db.VarChar(32)
  /// 设备ID
  deviceId      String?   @map("device_id") @db.VarChar(128)
  /// 登录地点
  location      String?   @db.VarChar(256)
  /// 会话ID
  sessionId     String?   @map("session_id") @db.VarChar(128)
  /// 登录时间
  loginAt       DateTime  @default(now()) @map("login_at")
  /// 登出时间
  logoutAt      DateTime? @map("logout_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([loginResult])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("login_history")
}

/// 密码历史表 - 用户密码变更记录
model PasswordHistory {
  /// 主键ID
  id           String   @id @default(uuid()) @db.Char(36)
  /// 用户ID
  userId       String   @map("user_id") @db.Char(36)
  /// 密码哈希值
  passwordHash String   @map("password_hash") @db.VarChar(255)
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_history")
}

/// 仓库表 - 仓库基本信息
model Warehouse {
  /// 主键ID
  id                     String                 @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId               String                 @map("tenant_id") @db.Char(36)
  /// 仓库编码（唯一标识）
