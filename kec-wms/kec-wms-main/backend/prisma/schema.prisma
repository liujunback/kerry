  @@unique([tenantId, reasonCode])
  @@index([tenantId])
  @@map("short_receive_reason_code")
}

/// 收货差异表 - 记录收货差异
model ReceivingDiscrepancy {
  /// 主键ID
  id                   String                  @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId             String                  @map("tenant_id") @db.Char(36)
  /// 差异编号
  discrepancyNumber    String                  @unique @map("discrepancy_number") @db.VarChar(32)
  /// ASN ID
  asnId                String                  @map("asn_id") @db.Char(36)
  /// ASN行ID
  asnLineId            String?                 @map("asn_line_id") @db.Char(36)
  /// 容器ID
  containerId          String?                 @map("container_id") @db.Char(36)
  /// 仓库ID
  warehouseId          String                  @map("warehouse_id") @db.Char(36)
  /// 客户ID
  clientId             String                  @map("client_id") @db.Char(36)
  /// 差异类型：QTY_SHORT-数量短收, WRONG_SKU-SKU错误, QUALITY_ISSUE-质量问题, PACKAGING_ISSUE-包装问题, BATCH_MISMATCH-批次不符, DOC_MISMATCH-单据不符
  discrepancyType      String                  @map("discrepancy_type") @db.VarChar(32)
  /// SKU ID
  skuId                String?                 @map("sku_id") @db.Char(36)
  /// SKU编码
  skuCode              String                  @map("sku_code") @db.VarChar(32)
  /// 预期值
  expectedValue        String?                 @map("expected_value") @db.VarChar(255)
  /// 实际值
  actualValue          String?                 @map("actual_value") @db.VarChar(255)
  /// 数量差异（负值表示短收）
  qtyDifference        Int?                    @map("qty_difference")
  /// 严重程度：LOW-低, MEDIUM-中, HIGH-高, CRITICAL-严重
  severity             String                  @default("MEDIUM") @db.VarChar(20)
  /// 状态：REPORTED-已报告, INVESTIGATING-调查中, PENDING_SUPPLIER-等待供应商, RESOLVED-已解决, AUTO_RESOLVED-自动解决, CLAIM_CREATED-已创建索赔, CLAIM_SETTLED-索赔已结算, CLOSED-已关闭
  status               String                  @default("REPORTED") @db.VarChar(32)
  /// 短收原因ID
  shortReceiveReasonId String?                 @map("short_receive_reason_id") @db.Char(36)
  /// 处理方式：ACCEPT-接受, REJECT-拒收, ADJUST-调整, CLAIM-索赔, RETURN_TO_VENDOR-退回供应商, PENDING_RECEIPT-待后续收货, WRITE_OFF-核销
  resolutionType       String?                 @map("resolution_type") @db.VarChar(32)
  /// 处理备注
  resolutionNote       String?                 @map("resolution_note") @db.Text
  /// 索赔单ID
  claimId              String?                 @map("claim_id") @db.VarChar(32)
  /// 报告人ID
  reportedBy           String                  @map("reported_by") @db.Char(36)
  /// 报告时间
  reportedAt           DateTime                @map("reported_at")
  /// 处理人ID
  resolvedBy           String?                 @map("resolved_by") @db.Char(36)
  /// 处理时间
  resolvedAt           DateTime?               @map("resolved_at")
  /// 创建时间
  createdAt            DateTime                @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime                @updatedAt @map("updated_at")
  asn                  Asn                     @relation(fields: [asnId], references: [id])
  asnLine              AsnLine?                @relation(fields: [asnLineId], references: [id])
  client               Client                  @relation(fields: [clientId], references: [id])
  container            Container?              @relation(fields: [containerId], references: [id])
  shortReceiveReason   ShortReceiveReasonCode? @relation(fields: [shortReceiveReasonId], references: [id])
  sku                  Sku?                    @relation(fields: [skuId], references: [id])
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  warehouse            Warehouse               @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([asnId])
  @@index([status])
  @@index([discrepancyType])
  @@index([asnLineId], map: "receiving_discrepancy_asn_line_id_fkey")
  @@index([clientId], map: "receiving_discrepancy_client_id_fkey")
  @@index([containerId], map: "receiving_discrepancy_container_id_fkey")
  @@index([shortReceiveReasonId], map: "receiving_discrepancy_short_receive_reason_id_fkey")
  @@index([skuId], map: "receiving_discrepancy_sku_id_fkey")
  @@index([warehouseId], map: "receiving_discrepancy_warehouse_id_fkey")
  @@map("receiving_discrepancy")
}

/// 定时任务表 - 可配置的定时任务
model ScheduledTask {
  /// 主键ID
  id              String             @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String             @map("tenant_id") @db.Char(36)
  /// 任务编码（唯一标识）
  taskCode        String             @unique @map("task_code") @db.VarChar(64)
  /// 任务名称
  taskName        String             @map("task_name") @db.VarChar(128)
  /// 任务描述
  description     String?            @db.Text
  /// Cron表达式
  cronExpression  String             @map("cron_expression") @db.VarChar(64)
  /// 时区
  timezone        String             @default("Asia/Shanghai") @db.VarChar(64)
  /// 处理器名称
  handler         String             @db.VarChar(64)
  /// 任务参数（JSON格式）
  params          Json?
  /// 是否启用
  isActive        Boolean            @default(true) @map("is_active")
  /// 上次执行时间
  lastRunAt       DateTime?          @map("last_run_at")
  /// 上次执行状态
  lastRunStatus   String?            @map("last_run_status") @db.VarChar(20)
  /// 上次执行消息
  lastRunMessage  String?            @map("last_run_message") @db.Text
  /// 上次执行耗时（毫秒）
  lastRunDuration Int?               @map("last_run_duration")
  /// 下次执行时间
  nextRunAt       DateTime?          @map("next_run_at")
  /// 执行次数
  runCount        Int                @default(0) @map("run_count")
  /// 失败次数
  failCount       Int                @default(0) @map("fail_count")
  /// 创建时间
  createdAt       DateTime           @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime           @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy       String?            @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy       String?            @map("updated_by") @db.Char(36)
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  logs            ScheduledTaskLog[]

  @@index([tenantId])
  @@index([isActive])
  @@index([handler])
  @@map("scheduled_task")
}

/// 定时任务执行日志表
model ScheduledTaskLog {
  /// 主键ID
  id          String        @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId    String        @map("tenant_id") @db.Char(36)
  /// 任务ID
  taskId      String        @map("task_id") @db.Char(36)
  /// 任务编码
  taskCode    String        @map("task_code") @db.VarChar(64)
  /// 执行状态：RUNNING-执行中, SUCCESS-成功, FAILED-失败
  status      String        @db.VarChar(20)
  /// 执行消息
  message     String?       @db.Text
  /// 错误堆栈
  errorStack  String?       @map("error_stack") @db.Text
  /// 执行耗时（毫秒）
  duration    Int?
  /// 开始时间
  startedAt   DateTime      @map("started_at")
  /// 完成时间
  completedAt DateTime?     @map("completed_at")
  /// 创建时间
  createdAt   DateTime      @default(now()) @map("created_at")
  task        ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([taskId])
  @@index([status])
  @@index([startedAt])
  @@map("scheduled_task_log")
}

/// 签出单表 - 打板/装袋签出主表
model CheckoutOrder {
  /// 主键ID
  id              String           @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String           @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId     String           @map("warehouse_id") @db.Char(36)
  /// 出库总单ID
  manifestOrderId String?          @map("manifest_order_id") @db.Char(36)
  /// 签出单号（板号/袋号）
  checkoutNumber  String           @map("checkout_number") @db.VarChar(64)
  /// 签出类型：PALLET-打板, BAG-装袋
  checkoutType    String           @map("checkout_type") @db.VarChar(16)
  /// 状态：PENDING-待签出, CHECKED_OUT-已签出, MOUNTED-已装运, MANIFESTED-已集运
  status          String           @default("PENDING") @db.VarChar(32)
  /// 渠道名称
  channelName     String?          @map("channel_name") @db.VarChar(128)
  /// 渠道编码
  channelCode     String?          @map("channel_code") @db.VarChar(64)
  /// 订单数量
  orderCount      Int              @default(0) @map("order_count")
  /// 包裹数量
  parcelCount     Int              @default(0) @map("parcel_count")
  /// 签出时间
  checkedOutAt    DateTime?        @map("checked_out_at")
  /// 签出操作人ID
  checkedOutBy    String?          @map("checked_out_by") @db.Char(36)
  /// 装运时间
  mountedAt       DateTime?        @map("mounted_at")
  /// 装运操作人ID
  mountedBy       String?          @map("mounted_by") @db.Char(36)
  /// 集运完结时间
  manifestedAt    DateTime?        @map("manifested_at")
  /// 集运完结操作人ID
  manifestedBy    String?          @map("manifested_by") @db.Char(36)
  /// 创建时间
  createdAt       DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime         @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy       String?          @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy       String?          @map("updated_by") @db.Char(36)
  manifestOrder   ManifestOrder?   @relation(fields: [manifestOrderId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  records         CheckoutRecord[]

  @@unique([tenantId, checkoutNumber])
  @@index([tenantId, status])
  @@index([warehouseId])
  @@index([manifestOrderId])
  @@map("checkout_order")
}

/// 签出扫描记录表 - 签出单明细
model CheckoutRecord {
  /// 主键ID
  id              String        @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String        @map("tenant_id") @db.Char(36)
  /// 签出单ID
  checkoutOrderId String        @map("checkout_order_id") @db.Char(36)
  /// 序号（扫描顺序）
  sequenceNumber  Int           @map("sequence_number")
  /// 扫描单号（物流单号或订单号）
  scannedNumber   String        @map("scanned_number") @db.VarChar(64)
  /// 单号类型：TRACKING-物流单号, ORDER-订单号
  numberType      String        @map("number_type") @db.VarChar(16)
  /// 订单ID
  orderId         String        @map("order_id") @db.Char(36)
  /// 订单号
  orderNumber     String        @map("order_number") @db.VarChar(32)
  /// 发货单ID
  shipmentId      String?       @map("shipment_id") @db.Char(36)
  /// 物流单号
  trackingNumber  String?       @map("tracking_number") @db.VarChar(64)
  /// 渠道名称
  channelName     String?       @map("channel_name") @db.VarChar(128)
  /// 渠道编码
  channelCode     String?       @map("channel_code") @db.VarChar(64)
  /// 扫描时间
  scannedAt       DateTime      @default(now()) @map("scanned_at")
  /// 扫描操作人ID
  scannedBy       String?       @map("scanned_by") @db.Char(36)
  /// 创建时间
  createdAt       DateTime      @default(now()) @map("created_at")
  checkoutOrder   CheckoutOrder @relation(fields: [checkoutOrderId], references: [id])
  order           OutboundOrder @relation(fields: [orderId], references: [id])
  shipment        Shipment?     @relation(fields: [shipmentId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  scannedByUser   User?         @relation("CheckoutRecordScannedBy", fields: [scannedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([checkoutOrderId, scannedNumber])
  @@index([tenantId, checkoutOrderId])
  @@index([orderId])
  @@index([trackingNumber])
  @@index([shipmentId], map: "checkout_record_shipment_id_fkey")
  @@index([scannedBy])
  @@map("checkout_record")
}

/// 出库总单表 - 汇总多个签出单的出库总单
model ManifestOrder {
  /// 主键ID
  id             String          @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId       String          @map("tenant_id") @db.Char(36)
  /// 仓库ID
  warehouseId    String          @map("warehouse_id") @db.Char(36)
  /// 出库总单号
  manifestNumber String          @map("manifest_number") @db.VarChar(64)
  /// 状态：CREATED-已创建, IN_PROGRESS-进行中, COMPLETED-已完结, CANCELLED-已取消
  status         String          @default("CREATED") @db.VarChar(32)
  /// 渠道编码
  channelCode    String?         @map("channel_code") @db.VarChar(64)
  /// 渠道名称
  channelName    String?         @map("channel_name") @db.VarChar(128)
  /// 客户ID
  clientId       String?         @map("client_id") @db.Char(36)
  /// 订单数量（汇总）
  orderCount     Int             @default(0) @map("order_count")
  /// 包裹数量（汇总）
  parcelCount    Int             @default(0) @map("parcel_count")
  /// 板/袋数量
  containerCount Int             @default(0) @map("container_count")
  /// 总重量（千克）
  totalWeightKg  Decimal?        @map("total_weight_kg") @db.Decimal(12, 3)
  /// 完结时间
  completedAt    DateTime?       @map("completed_at")
  /// 完结操作人ID
  completedBy    String?         @map("completed_by") @db.Char(36)
  /// 备注
  notes          String?         @db.Text
  /// 创建时间
  createdAt      DateTime        @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime        @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy      String?         @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy      String?         @map("updated_by") @db.Char(36)
  checkoutOrders CheckoutOrder[]
  client         Client?         @relation(fields: [clientId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  orders         OutboundOrder[]

  @@unique([tenantId, manifestNumber])
  @@index([tenantId, status])
  @@index([warehouseId])
  @@index([channelCode])
  @@index([clientId])
  @@index([createdAt])
  @@index([completedAt])
  @@map("manifest_order")
}

/// 打印模板表 - 管理各类标签和单据的打印模板
model PrintTemplate {
  /// 主键ID
  id              String         @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId        String         @map("tenant_id") @db.Char(36)
  /// 模板名称
  name            String         @db.VarChar(128)
  /// 面单类型: SERVICE_PROVIDER_LABEL, CUSTOM_LABEL, PACKING_LIST, SKU_LABEL, INVOICE
  labelType       String         @map("label_type") @db.VarChar(32)
  /// 业务标签类型: PDA_LOGIN_QR, SKU_LABEL, SHIPMENT_LABEL 等
  scenarioType    String?        @map("scenario_type") @db.VarChar(64)
  /// 标签规格编码: LABEL_90X130, CUSTOM_75X50 等
  labelSpecCode   String?        @map("label_spec_code") @db.VarChar(64)
  /// 适用仓库ID，null 表示全局默认
  warehouseId     String?        @map("warehouse_id") @db.Char(36)
  /// 宽度(mm)
  widthMm         Decimal        @map("width_mm") @db.Decimal(8, 2)
  /// 高度(mm)
  heightMm        Decimal        @map("height_mm") @db.Decimal(8, 2)
  /// 方向: portrait/landscape
  orientation     String         @default("portrait") @db.VarChar(16)
  /// 页边距 JSON: { top, right, bottom, left }
  margins         Json?
  /// 模板内容（HTML/CSS）
  templateContent String?        @map("template_content") @db.Text
  /// 字段映射配置 JSON
  fieldMappings   Json?          @map("field_mappings")
  /// 是否默认模板
  isDefault       Boolean        @default(false) @map("is_default")
  /// 是否启用
  isActive        Boolean        @default(true) @map("is_active")
  /// 创建时间
  createdAt       DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime       @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy       String?        @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy       String?        @map("updated_by") @db.Char(36)
  /// 默认打印设备ID
  defaultDeviceId String?        @map("default_device_id") @db.Char(36)
  printHistories  PrintHistory[]
  defaultDevice   PrintDevice?   @relation("TemplateDefaultDevice", fields: [defaultDeviceId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, labelType])
  @@index([tenantId, scenarioType])
  @@index([tenantId, labelSpecCode])
  @@index([warehouseId])
  @@index([defaultDeviceId])
  @@map("print_template")
}

/// 打印标签规格表 - 管理固定规格和租户自定义纸张尺寸
model PrintLabelSpec {
  /// 主键ID
  id          String   @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId    String   @map("tenant_id") @db.Char(36)
  /// 规格编码: LABEL_90X130, CUSTOM_75X50_PORTRAIT_...
  code        String   @db.VarChar(64)
  /// 规格名称
  name        String   @db.VarChar(128)
  /// 宽度(mm)
  widthMm     Decimal  @map("width_mm") @db.Decimal(8, 2)
  /// 高度(mm)
  heightMm    Decimal  @map("height_mm") @db.Decimal(8, 2)
  /// 方向: portrait/landscape
  orientation String   @default("portrait") @db.VarChar(16)
  /// 是否系统内置规格
  isSystem    Boolean  @default(false) @map("is_system")
  /// 是否启用
  isActive    Boolean  @default(true) @map("is_active")
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy   String?  @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy   String?  @map("updated_by") @db.Char(36)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("print_label_spec")
}

/// 打印设备表 - 管理打印机设备信息
model PrintDevice {
  /// 主键ID
  id                 String          @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId           String          @map("tenant_id") @db.Char(36)
  /// 设备名称
  name               String          @db.VarChar(128)
  /// 设备类型: THERMAL, LASER, INKJET, PORTABLE, VIRTUAL
  deviceType         String          @map("device_type") @db.VarChar(32)
  /// 连接方式: NETWORK, USB, BLUETOOTH
  connectionType     String          @map("connection_type") @db.VarChar(16)
  /// Windows/macOS/Linux 打印队列名称（USB/蓝牙/系统打印时使用）
  printerName        String?         @map("printer_name") @db.VarChar(128)
  /// IP地址（网络连接时使用）
  ipAddress          String?         @map("ip_address") @db.VarChar(64)
  /// 端口号（网络连接时使用）
  port               Int?
  /// 物理位置描述
  location           String?         @db.VarChar(128)
  /// 字符集
  charset            String          @default("UTF-8") @db.VarChar(16)
  /// 分辨率 DPI
  dpi                Int             @default(203)
  /// 是否在线
  isOnline           Boolean         @default(false) @map("is_online")
  /// 最后在线时间
  lastOnlineAt       DateTime?       @map("last_online_at")
  /// 是否启用
  isActive           Boolean         @default(true) @map("is_active")
  /// 创建时间
  createdAt          DateTime        @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime        @updatedAt @map("updated_at")
  /// 创建人ID
  createdBy          String?         @map("created_by") @db.Char(36)
  /// 更新人ID
  updatedBy          String?         @map("updated_by") @db.Char(36)
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  printHistories     PrintHistory[]
  templatesAsDefault PrintTemplate[] @relation("TemplateDefaultDevice")

  @@index([tenantId])
  @@map("print_device")
}

/// 打印历史表 - 记录每次打印操作
model PrintHistory {
  /// 主键ID
  id           String         @id @default(uuid()) @db.Char(36)
  /// 租户ID
  tenantId     String         @map("tenant_id") @db.Char(36)
  /// 打印设备ID
  deviceId     String?        @map("device_id") @db.Char(36)
  /// 使用模板ID
  templateId   String?        @map("template_id") @db.Char(36)
  /// 面单类型
  labelType    String         @map("label_type") @db.VarChar(32)
  /// 业务标签类型
  scenarioType String?        @map("scenario_type") @db.VarChar(64)
  /// 标签规格编码
  labelSpecCode String?       @map("label_spec_code") @db.VarChar(64)
  /// 打印时使用的仓库ID
  warehouseId   String?       @map("warehouse_id") @db.Char(36)
  /// 关联业务ID（订单/发货单等）
  relatedId    String?        @map("related_id") @db.Char(36)
  /// 关联业务类型: ORDER, SHIPMENT, SKU 等
  relatedType  String?        @map("related_type") @db.VarChar(32)
  /// 打印页数
  pageCount    Int            @default(1) @map("page_count")
  /// 打印状态: PENDING, PRINTING, SUCCESS, FAILED
  status       String         @db.VarChar(16)
  /// 错误信息
  errorMessage String?        @map("error_message") @db.Text
  /// 打印时间
  printedAt    DateTime       @default(now()) @map("printed_at")
  /// 操作人ID
  printedById  String?        @map("printed_by_id") @db.Char(36)
  device       PrintDevice?   @relation(fields: [deviceId], references: [id])
  printedBy    User?          @relation(fields: [printedById], references: [id])
  template     PrintTemplate? @relation(fields: [templateId], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, printedAt])
  @@index([tenantId, scenarioType])
  @@index([tenantId, labelSpecCode])
  @@index([warehouseId])
  @@index([deviceId])
  @@index([templateId])
  @@index([printedById], map: "print_history_printed_by_id_fkey")
  @@map("print_history")
}

// ==================== E2E 测试场景管理 ====================

/// E2E测试场景分类
model E2eScenarioCategory {
  /// 主键ID
  id          String        @id @default(uuid()) @db.Char(36)
  /// 分类编码: RECEIVING, PUTAWAY, OUTBOUND 等
  code        String        @unique @db.VarChar(50)
  /// 分类名称
  name        String        @db.VarChar(100)
  /// 分类描述
  description String?       @db.Text
  /// 排序号
  sortOrder   Int           @default(0) @map("sort_order")
  /// 是否启用
  isActive    Boolean       @default(true) @map("is_active")
  /// 创建时间
  createdAt   DateTime      @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime      @updatedAt @map("updated_at")
  /// 关联场景
  scenarios   E2eScenario[]

  @@map("e2e_scenario_categories")
}

/// E2E测试场景
model E2eScenario {
  /// 主键ID
  id          String              @id @default(uuid()) @db.Char(36)
  /// 分类ID
  categoryId  String              @map("category_id") @db.Char(36)
  /// 场景编码: RCV-NORMAL-001, PUT-BATCH-001 等
  code        String              @unique @db.VarChar(50)
  /// 场景名称
  name        String              @db.VarChar(200)
  /// 场景描述
  description String?             @db.Text
  /// 场景配置（JSON）: { skuType, expectedQty, receivingSteps, putawaySteps, dependencies, ... }
  config      Json
  /// 预期结果（JSON）: { asnStatus, totalReceivedQty, putawayStatus, inventoryInBins, ... }
  expected    Json
  /// 是否启用
  isActive    Boolean             @default(true) @map("is_active")
  /// 排序号
  sortOrder   Int                 @default(0) @map("sort_order")
  /// 创建时间
  createdAt   DateTime            @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime            @updatedAt @map("updated_at")
  /// 关联分类
  category    E2eScenarioCategory @relation(fields: [categoryId], references: [id])
  /// 执行结果
  results     E2eScenarioResult[]

  @@index([categoryId])
  @@index([code])
  @@map("e2e_scenarios")
}

/// E2E测试场景执行结果
model E2eScenarioResult {
  /// 主键ID
  id           String      @id @default(uuid()) @db.Char(36)
  /// 场景ID
  scenarioId   String      @map("scenario_id") @db.Char(36)
  /// 执行状态: PASSED, FAILED, ERROR
  status       String      @db.VarChar(20)
  /// 执行耗时（毫秒）
  durationMs   Int?        @map("duration_ms")
  /// 执行步骤详情（JSON）: [{ name, status, duration, input, output, error }]
  steps        Json?
  /// 实际结果（JSON）
  actual       Json?
  /// 错误信息
  errorMessage String?     @map("error_message") @db.Text
  /// 执行时间
  executedAt   DateTime    @default(now()) @map("executed_at")
  /// 执行人ID
  executedBy   String?     @map("executed_by") @db.Char(36)
  /// 关联场景
  scenario     E2eScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([executedAt])
  @@map("e2e_scenario_results")
}
